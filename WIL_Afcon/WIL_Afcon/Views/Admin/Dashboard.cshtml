@model WIL_Afcon.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";

    var today = DateTime.Today;
}

<div class="min-h-screen bg-[#f5f7fc] lg:flex">


    <!-- ====================================================== -->
    <!-- SIDEBAR                                                -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>

                </svg>

            </div>

            <div>
                <p class="font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Admin Panel
                </p>
            </div>

        </div>


        <!-- NAVIGATION -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <nav class="flex-1 px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-500">
                    Administration
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                    </svg>

                    <span>Dashboard</span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary"></span>

                </a>


                <!-- EMPLOYEES -->
                <a asp-controller="Employee"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>

                    </svg>

                    Employees

                </a>


                <!-- DEPARTMENTS -->
                <a asp-controller="Department"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                        <path d="M9 22v-4h6v4"></path>
                        <path d="M8 6h.01"></path>
                        <path d="M12 6h.01"></path>
                        <path d="M16 6h.01"></path>

                    </svg>

                    Departments

                </a>


                <!-- ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M8 2v4"></path>
                        <path d="M16 2v4"></path>
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <path d="M3 10h18"></path>

                    </svg>

                    Attendance

                </a>


                <!-- ATTENDANCE REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                    </svg>

                    Requests

                </a>


                <!-- ATTENDANCE REPORTS -->
                <a asp-controller="AttendanceReport"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M3 3v18h18"></path>
                        <path d="m7 16 4-4 4 4 5-6"></path>

                    </svg>

                    Reports

                </a>

            </nav>


            <!-- SIDEBAR BOTTOM -->
            <div class="border-t border-slate-200 p-5">

                <div class="mb-4 flex items-center gap-3">

                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary font-semibold text-primary-content">
                        A
                    </div>

                    <div>
                        <p class="text-sm font-semibold text-slate-900">
                            Administrator
                        </p>

                        <p class="text-xs text-slate-500">
                            Admin
                        </p>
                    </div>

                </div>


                <!-- SIGN OUT -->
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" x2="9" y1="12" y2="12"></line>

                        </svg>

                        Sign Out

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN AREA                                              -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">


        <!-- ================================================== -->
        <!-- DASHBOARD CONTENT                                  -->
        <!-- ================================================== -->

        <main class="p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- PAGE HEADER                                       -->
            <!-- ================================================== -->

            <div class="mb-7 flex items-start justify-between gap-6">

                <!-- TITLE -->
                <div>

                    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                        Admin Dashboard
                    </h1>

                    <p class="mt-1 text-sm text-slate-500">
                        @today.ToString("dddd, d MMMM yyyy") — Overview
                    </p>

                </div>


                <!-- ADMIN ACTIONS -->
                <div class="flex shrink-0 items-center gap-3">

                    <!-- ADMIN AVATAR -->
                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-bold text-primary-content">
                        A
                    </div>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- STATISTIC CARDS                                    -->
            <!-- ================================================== -->

            <div class="mb-7 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">


                <!-- TOTAL EMPLOYEES -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="mb-5 flex items-start justify-between">

                        <p class="text-sm font-medium text-slate-500">
                            Total Employees
                        </p>

                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>

                            </svg>

                        </div>

                    </div>

                    <p class="text-3xl font-bold text-slate-900">
                        @Model.TotalEmployees
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Active staff
                    </p>

                </div>


                <!-- PRESENT TODAY -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="mb-5 flex items-start justify-between">

                        <p class="text-sm font-medium text-slate-500">
                            Present Today
                        </p>

                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-green-50 text-green-600">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="m9 11 3 3L22 4"></path>
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>

                            </svg>

                        </div>

                    </div>

                    <p class="text-3xl font-bold text-slate-900">
                        @Model.PresentToday
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Attended today
                    </p>

                </div>


                <!-- ON LEAVE -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="mb-5 flex items-start justify-between">

                        <p class="text-sm font-medium text-slate-500">
                            On Leave
                        </p>

                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="M8 2v4"></path>
                                <path d="M16 2v4"></path>
                                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                <path d="M3 10h18"></path>

                            </svg>

                        </div>

                    </div>

                    <p class="text-3xl font-bold text-slate-900">
                        @Model.OnLeaveToday
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Today
                    </p>

                </div>


                <!-- ABSENT TODAY -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="mb-5 flex items-start justify-between">

                        <p class="text-sm font-medium text-slate-500">
                            Absent Today
                        </p>

                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-50 text-red-600">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M17 8l5 5"></path>
                                <path d="M22 8l-5 5"></path>
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>

                            </svg>

                        </div>

                    </div>

                    <p class="text-3xl font-bold text-slate-900">
                        @Model.AbsentToday
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Recorded absent
                    </p>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- OVERVIEW SECTION                                   -->
            <!-- ================================================== -->

            <div class="mb-7 grid gap-6 xl:grid-cols-[2fr_1fr]">


                <!-- MONTHLY ATTENDANCE -->
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

                    <h2 class="text-xl font-bold text-slate-900">
                        Monthly Attendance Overview
                    </h2>

                    <p class="mt-1 text-sm text-slate-500">
                        Attendance records for the last six months
                    </p>


                    <div class="mt-7 overflow-x-auto">

                        <div class="min-w-[520px]">

                            <div class="grid grid-cols-6 gap-3">

                                @foreach (var month in Model.MonthlyAttendance)
                                {
                                    var total =
                                        month.Present +
                                        month.Absent +
                                        month.Late;

                                    var presentHeight =
                                        total == 0
                                            ? 0
                                            : (month.Present * 100 / total);

                                    <div class="flex flex-col items-center">

                                        <div class="flex h-44 w-full items-end justify-center rounded-lg bg-slate-50 px-3">

                                            <div class="w-full max-w-10 rounded-t-lg bg-primary/80"
                                                 style="height: @(presentHeight)%;">
                                            </div>

                                        </div>

                                        <p class="mt-3 text-xs font-medium text-slate-500">
                                            @month.Month
                                        </p>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>


                    <!-- CHART LEGEND -->
                    <div class="mt-5 flex flex-wrap justify-center gap-5 text-xs">

                        <span class="flex items-center gap-2 text-slate-500">
                            <span class="h-2.5 w-2.5 rounded-full bg-primary"></span>
                            Present
                        </span>

                        <span class="flex items-center gap-2 text-slate-500">
                            <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
                            Absent
                        </span>

                        <span class="flex items-center gap-2 text-slate-500">
                            <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
                            Late
                        </span>

                    </div>

                </div>


                <!-- ================================================== -->
                <!-- TODAY AT A GLANCE                                  -->
                <!-- ================================================== -->

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

                    <h2 class="text-xl font-bold text-slate-900">
                        Today at a Glance
                    </h2>


                    @if (Model.TodayAttendance.Any())
                    {
                        <div class="mt-5 space-y-4">

                            @foreach (var employee in Model.TodayAttendance.Take(6))
                            {
                                var initials =
                                    $"{employee.FirstName.FirstOrDefault()}{employee.LastName.FirstOrDefault()}";

                                var badgeClass =
                                    employee.Status == "Present"
                                        ? "bg-green-50 text-green-700 ring-green-200"
                                        : employee.Status == "Late"
                                            ? "bg-amber-50 text-amber-700 ring-amber-200"
                                            : employee.Status == "OnLeave"
                                                ? "bg-blue-50 text-blue-700 ring-blue-200"
                                                : employee.Status == "HalfDay"
                                                    ? "bg-purple-50 text-purple-700 ring-purple-200"
                                                    : "bg-red-50 text-red-700 ring-red-200";


                                <div class="flex items-center gap-3">

                                    <!-- INITIALS -->
                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary">
                                        @initials
                                    </div>


                                    <!-- EMPLOYEE -->
                                    <div class="min-w-0 flex-1">

                                        <p class="truncate text-sm font-semibold text-slate-900">
                                            @employee.FirstName @employee.LastName
                                        </p>

                                        <p class="text-xs text-slate-500">
                                            @employee.EmployeeNumber
                                        </p>

                                    </div>


                                    <!-- STATUS -->
                                    <span class="rounded-full px-3 py-1 text-xs font-medium ring-1 @badgeClass">
                                        @employee.Status
                                    </span>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="flex min-h-52 items-center justify-center">

                            <div class="text-center">

                                <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-slate-100 text-slate-400">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         class="h-5 w-5">

                                        <path d="M8 2v4"></path>
                                        <path d="M16 2v4"></path>
                                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                        <path d="M3 10h18"></path>

                                    </svg>

                                </div>

                                <p class="mt-3 text-sm font-medium text-slate-700">
                                    No attendance recorded yet
                                </p>

                                <p class="mt-1 text-xs text-slate-500">
                                    Today's attendance will appear here.
                                </p>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- ================================================== -->
            <!-- QUICK ACTIONS                                      -->
            <!-- ================================================== -->

            <div class="grid gap-4 md:grid-cols-3">


                <!-- MANAGE EMPLOYEES -->
                <a asp-controller="Employee"
                   asp-action="Index"
                   class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 no-underline shadow-sm transition hover:border-primary/30 hover:shadow-md">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>

                        </svg>

                    </div>

                    <div class="min-w-0 flex-1">

                        <p class="font-semibold text-slate-900">
                            Manage Employees
                        </p>

                        <p class="text-sm text-slate-500">
                            Add, edit and view staff
                        </p>

                    </div>

                    <span class="text-xl text-slate-400 transition group-hover:translate-x-1 group-hover:text-primary">
                        ›
                    </span>

                </a>


                <!-- VIEW ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="Index"
                   class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 no-underline shadow-sm transition hover:border-primary/30 hover:shadow-md">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <circle cx="12" cy="12" r="9"></circle>
                            <path d="M12 7v5l3 2"></path>

                        </svg>

                    </div>

                    <div class="min-w-0 flex-1">

                        <p class="font-semibold text-slate-900">
                            View Attendance
                        </p>

                        <p class="text-sm text-slate-500">
                            View employee records
                        </p>

                    </div>

                    <span class="text-xl text-slate-400 transition group-hover:translate-x-1 group-hover:text-primary">
                        ›
                    </span>

                </a>


                <!-- ATTENDANCE REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Index"
                   class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 no-underline shadow-sm transition hover:border-primary/30 hover:shadow-md">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <path d="M9 11l3 3L22 4"></path>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                        </svg>

                    </div>

                    <div class="min-w-0 flex-1">

                        <p class="font-semibold text-slate-900">
                            Attendance Requests
                        </p>

                        <p class="text-sm text-slate-500">
                            Review employee requests
                        </p>

                    </div>

                    <span class="text-xl text-slate-400 transition group-hover:translate-x-1 group-hover:text-primary">
                        ›
                    </span>

                </a>

            </div>

        </main>

    </div>

</div>