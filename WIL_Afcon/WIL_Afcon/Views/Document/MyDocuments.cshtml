@model List<WIL_Afcon.Models.Document>

@{
    ViewData["Title"] = "My Documents";

    var documentCount = Model?.Count ?? 0;
}

<div class="min-h-screen bg-[#f5f7fc] lg:flex">

    <!-- ====================================================== -->
    <!-- EMPLOYEE SIDEBAR                                       -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:z-50 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>

                </svg>

            </div>

            <div>
                <p class="text-base font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Employee Portal
                </p>
            </div>

        </div>


        <!-- SIDEBAR CONTENT -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <nav class="flex-1 px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-400">
                    Employee
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Employee"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                    </svg>

                    <span>Dashboard</span>

                </a>


                <!-- MY ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="MyAttendance"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 2"></path>

                    </svg>

                    <span>My Attendance</span>

                </a>


                <!-- MY REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="MyRequests"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                    </svg>

                    <span>My Requests</span>

                </a>


                <!-- MY DOCUMENTS - ACTIVE -->
                <a asp-action="MyDocuments"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                        <path d="M14 2v6h6"></path>
                        <path d="M8 13h8"></path>
                        <path d="M8 17h5"></path>

                    </svg>

                    <span>My Documents</span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary"></span>

                </a>


                <!-- NEW REQUEST -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Create"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v8"></path>
                        <path d="M8 12h8"></path>

                    </svg>

                    <span>New Request</span>

                </a>

            </nav>


            <!-- SIGN OUT -->
            <div class="border-t border-slate-200 p-5">

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5 shrink-0">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" x2="9" y1="12" y2="12"></line>

                        </svg>

                        <span>Sign Out</span>

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">

        <main class="mx-auto max-w-7xl p-6 lg:p-9">

            <!-- PAGE HEADER -->
            <div class="mb-7">

                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    My Documents
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Access and download your payslips and IRP5 documents.
                </p>

            </div>


            <!-- SUMMARY -->
            <div class="mb-6 max-w-sm rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                <div class="flex items-center justify-between">

                    <div>
                        <p class="text-sm font-medium text-slate-500">
                            Available Documents
                        </p>

                        <p class="mt-2 text-3xl font-bold text-slate-900">
                            @documentCount
                        </p>
                    </div>

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                            <path d="M14 2v6h6"></path>

                        </svg>

                    </div>

                </div>

            </div>


            <!-- DOCUMENTS -->
            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                <div class="border-b border-slate-200 px-6 py-5">

                    <h2 class="text-lg font-bold text-slate-900">
                        Documents
                    </h2>

                    <p class="mt-1 text-xs text-slate-500">
                        Documents uploaded to your employee account.
                    </p>

                </div>


                @if (Model == null || !Model.Any())
                {
                    <!-- EMPTY STATE -->
                    <div class="px-6 py-16 text-center">

                        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-6 w-6">

                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                                <path d="M14 2v6h6"></path>

                            </svg>

                        </div>

                        <h3 class="mt-4 font-semibold text-slate-900">
                            No documents available
                        </h3>

                        <p class="mx-auto mt-1 max-w-md text-sm text-slate-500">
                            No payslips or IRP5 documents have been uploaded for you yet.
                        </p>

                    </div>
                }
                else
                {
                    <div class="w-full">

                        <table class="w-full table-fixed text-left">

                            <thead class="bg-slate-50">

                                <tr class="border-b border-slate-200 text-xs font-semibold uppercase tracking-wide text-slate-500">

                                    <th class="w-[20%] px-6 py-4">
                                        Type
                                    </th>

                                    <th class="w-[40%] px-4 py-4">
                                        File Name
                                    </th>

                                    <th class="w-[25%] px-4 py-4">
                                        Uploaded
                                    </th>

                                    <th class="w-[15%] px-6 py-4 text-right">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody class="divide-y divide-slate-100">

                                @foreach (var document in Model)
                                {
                                    <tr class="transition hover:bg-slate-50">

                                        <!-- TYPE -->
                                        <td class="px-6 py-4">

                                            <div class="flex items-center gap-3">

                                                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">

                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         class="h-4 w-4">

                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                                                        <path d="M14 2v6h6"></path>

                                                    </svg>

                                                </div>

                                                <span class="text-sm font-semibold text-slate-900">
                                                    @document.DocumentType
                                                </span>

                                            </div>

                                        </td>


                                        <!-- FILE NAME -->
                                        <td class="px-4 py-4">

                                            <p class="truncate text-sm text-slate-700"
                                               title="@document.FileName">
                                                @document.FileName
                                            </p>

                                        </td>


                                        <!-- UPLOADED -->
                                        <td class="px-4 py-4">

                                            <div class="text-sm text-slate-700">
                                                @document.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")
                                            </div>

                                            <div class="mt-0.5 text-xs text-slate-400">
                                                @document.UploadedAt.ToLocalTime().ToString("HH:mm")
                                            </div>

                                        </td>


                                        <!-- DOWNLOAD -->
                                        <td class="px-6 py-4 text-right">

                                            <a asp-action="Download"
                                               asp-route-id="@document.Id"
                                               class="inline-flex items-center gap-2 rounded-lg bg-primary px-3 py-2 text-xs font-semibold text-primary-content no-underline transition hover:opacity-90">

                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     viewBox="0 0 24 24"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     stroke-width="2"
                                                     class="h-4 w-4">

                                                    <path d="M12 3v12"></path>
                                                    <path d="m7 10 5 5 5-5"></path>
                                                    <path d="M5 21h14"></path>

                                                </svg>

                                                Download

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>


            <!-- INFORMATION -->
            <div class="mt-6 flex gap-3 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="mt-0.5 h-5 w-5 shrink-0 text-primary">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 11v5"></path>
                    <path d="M12 8h.01"></path>

                </svg>

                <div>

                    <p class="text-sm font-semibold text-slate-800">
                        Employee Documents
                    </p>

                    <p class="mt-1 text-xs leading-5 text-slate-600">
                        Payslips and IRP5 documents uploaded by the administrator
                        will appear here for you to download.
                    </p>

                </div>

            </div>

        </main>

    </div>

</div>