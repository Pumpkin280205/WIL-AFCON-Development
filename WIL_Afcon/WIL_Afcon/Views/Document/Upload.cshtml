@{
    ViewData["Title"] = "Upload Document";
    var employee = (WIL_Afcon.Models.Employee)ViewBag.Employee;

    var initials =
        $"{employee.FirstName.FirstOrDefault()}{employee.LastName.FirstOrDefault()}";
}

<div class="min-h-screen bg-[#f5f7fc] lg:flex">


    <!-- ====================================================== -->
    <!-- SIDEBAR                                                -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>

                </svg>

            </div>

            <div>
                <p class="font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Admin Panel
                </p>
            </div>

        </div>


        <!-- NAVIGATION -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <nav class="flex-1 px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-500">
                    Administration
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                    </svg>

                    Dashboard

                </a>


                <!-- EMPLOYEES - ACTIVE -->
                <a asp-controller="Employee"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>

                    </svg>

                    <span>Employees</span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary"></span>

                </a>


                <!-- DEPARTMENTS -->
                <a asp-controller="Department"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                        <path d="M9 22v-4h6v4"></path>
                        <path d="M8 6h.01"></path>
                        <path d="M12 6h.01"></path>
                        <path d="M16 6h.01"></path>

                    </svg>

                    Departments

                </a>


                <!-- ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M8 2v4"></path>
                        <path d="M16 2v4"></path>
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <path d="M3 10h18"></path>

                    </svg>

                    Attendance

                </a>


                <!-- REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                    </svg>

                    Requests

                </a>


                <!-- REPORTS -->
                <a asp-controller="AttendanceReport"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M3 3v18h18"></path>
                        <path d="m7 16 4-4 4 4 5-6"></path>

                    </svg>

                    Reports

                </a>

            </nav>


            <!-- SIDEBAR BOTTOM -->
            <div class="border-t border-slate-200 p-5">

                <div class="mb-4 flex items-center gap-3">

                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary font-semibold text-primary-content">
                        A
                    </div>

                    <div>
                        <p class="text-sm font-semibold text-slate-900">
                            Administrator
                        </p>

                        <p class="text-xs text-slate-500">
                            Admin
                        </p>
                    </div>

                </div>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" x2="9" y1="12" y2="12"></line>

                        </svg>

                        Sign Out

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">

        <main id="main-content" tabindex="-1" class="p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- PAGE HEADER                                       -->
            <!-- ================================================== -->

            <div class="mb-7">

                <a asp-controller="Employee"
                   asp-action="Details"
                   asp-route-id="@employee.Id"
                   class="mb-4 inline-flex items-center gap-2 text-sm font-medium text-slate-500 no-underline transition hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-4 w-4">

                        <path d="M19 12H5"></path>
                        <path d="m11 18-6-6 6-6"></path>

                    </svg>

                    Back to Employee Details

                </a>


                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    Upload Document
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Upload a payslip or IRP5 document to the employee's record.
                </p>

            </div>


            <!-- ================================================== -->
            <!-- CONTENT                                           -->
            <!-- ================================================== -->

            <div class="grid max-w-5xl gap-6 lg:grid-cols-[280px_1fr]">


                <!-- ================================================== -->
                <!-- EMPLOYEE CARD                                     -->
                <!-- ================================================== -->

                <div>

                    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

                        <p class="mb-5 text-xs font-semibold uppercase tracking-widest text-slate-400">
                            Employee
                        </p>


                        <div class="text-center">

                            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-lg font-bold uppercase text-primary">
                                @initials
                            </div>


                            <h2 class="mt-4 text-lg font-bold text-slate-900">
                                @employee.FirstName @employee.LastName
                            </h2>


                            <p class="mt-1 text-sm font-medium text-slate-500">
                                @employee.EmployeeNumber
                            </p>

                        </div>


                        <div class="my-5 border-t border-slate-200"></div>


                        <div>

                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Email
                            </p>

                            <p class="mt-1 break-words text-sm font-medium text-slate-700">
                                @employee.Email
                            </p>

                        </div>


                        <div class="mt-4">

                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Status
                            </p>


                            @if (employee.IsActive)
                            {
                                <span class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700 ring-1 ring-green-200">

                                    <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>

                                    Active

                                </span>
                            }
                            else
                            {
                                <span class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500 ring-1 ring-slate-200">

                                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>

                                    Inactive

                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- ================================================== -->
                <!-- UPLOAD FORM                                       -->
                <!-- ================================================== -->

                <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


                    <!-- CARD HEADER -->
                    <div class="border-b border-slate-200 px-6 py-5">

                        <div class="flex items-center gap-3">

                            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     class="h-5 w-5">

                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>

                                </svg>

                            </div>


                            <div>

                                <h2 class="text-lg font-semibold text-slate-900">
                                    Document Information
                                </h2>

                                <p class="text-sm text-slate-500">
                                    Select the document type and file to upload.
                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- VALIDATION -->
                    <div asp-validation-summary="ModelOnly" role="alert"
                         class="px-6 pt-5 text-sm text-red-600">
                    </div>


                    <!-- FORM -->
                    <form asp-action="Upload"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="employeeId"
                               value="@employee.Id" />


                        <div class="space-y-6 p-6">


                            <!-- DOCUMENT TYPE -->
                            <div>

                                <label for="documentType"
                                       class="mb-2 block text-sm font-medium text-slate-700">
                                    Document Type
                                </label>


                                <select name="documentType"
                                        id="documentType"
                                        class="w-full rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10">

                                    @foreach (var type in Enum.GetValues<WIL_Afcon.Models.Enums.DocumentType>())
                                    {
                                        <option value="@type">
                                            @type
                                        </option>
                                    }

                                </select>

                                <p class="mt-2 text-xs text-slate-400">
                                    Choose whether you are uploading a payslip or IRP5 document.
                                </p>

                            </div>


                            <!-- FILE -->
                            <div>

                                <label for="file"
                                       class="mb-2 block text-sm font-medium text-slate-700">
                                    File
                                </label>


                                <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-5">

                                    <div class="mb-4 flex items-center gap-3">

                                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-white text-primary shadow-sm">

                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 viewBox="0 0 24 24"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 stroke-width="2"
                                                 class="h-5 w-5">

                                                <path d="M12 3v12"></path>
                                                <path d="m7 8 5-5 5 5"></path>
                                                <path d="M5 21h14"></path>

                                            </svg>

                                        </div>


                                        <div>

                                            <p class="text-sm font-semibold text-slate-800">
                                                Select a document
                                            </p>

                                            <p class="text-xs text-slate-500">
                                                Choose the employee document from your computer.
                                            </p>

                                        </div>

                                    </div>


                                    <input type="file"
                                           name="file"
                                           accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"
                                           id="file"
                                           required
                                           class="block w-full cursor-pointer rounded-lg border border-slate-200 bg-white text-sm text-slate-600 file:mr-4 file:border-0 file:bg-primary/10 file:px-4 file:py-3 file:text-sm file:font-semibold file:text-primary hover:file:bg-primary/15" />

                                </div>


                                <!-- FILE NAME REQUIREMENT -->
                                <div class="mt-3 flex items-start gap-2 rounded-lg bg-amber-50 px-4 py-3 text-amber-800">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         class="mt-0.5 h-4 w-4 shrink-0">

                                        <circle cx="12" cy="12" r="10"></circle>
                                        <path d="M12 16v-4"></path>
                                        <path d="M12 8h.01"></path>

                                    </svg>


                                    <p class="text-xs leading-5">
                                        The file name must include the employee's name or employee number.
                                        For example:
                                        <span class="font-semibold">
                                            @(employee.LastName)_Payslip_March.pdf
                                        </span>
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================== -->
                        <!-- ACTIONS                                            -->
                        <!-- ================================================== -->

                        <div class="flex items-center justify-end gap-3 border-t border-slate-200 bg-slate-50 px-6 py-5">


                            <!-- CANCEL -->
                            <a asp-controller="Employee"
                               asp-action="Details"
                               asp-route-id="@employee.Id"
                               class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 no-underline transition hover:bg-slate-100">

                                Cancel

                            </a>


                            <!-- UPLOAD -->
                            <button type="submit"
                                    class="inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-semibold text-primary-content shadow-sm transition hover:opacity-90">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     class="h-4 w-4">

                                    <path d="M12 3v12"></path>
                                    <path d="m7 8 5-5 5 5"></path>
                                    <path d="M5 21h14"></path>

                                </svg>

                                Upload Document

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </main>

    </div>

</div>