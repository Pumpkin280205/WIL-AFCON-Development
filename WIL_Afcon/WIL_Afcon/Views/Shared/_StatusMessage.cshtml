@* Success / error message set by a controller through TempData["Success"] or
   TempData["Error"] before a redirect. Rendered once from _Layout so every page
   shows feedback the same way. role="status" / role="alert" make screen readers
   announce it; site.js handles the close button and auto-hide. *@
@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}

@if (!string.IsNullOrWhiteSpace(success) || !string.IsNullOrWhiteSpace(error))
{
    <div class="toast-stack">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="toast-message toast-error" role="alert">
                <svg class="toast-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
                <p class="toast-text">@error</p>
                <button type="button" class="toast-close" data-action="dismiss-toast" aria-label="Dismiss message">&times;</button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(success))
        {
            <div class="toast-message toast-success" role="status" data-auto-hide="true">
                <svg class="toast-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="8 12 11 15 16 9" />
                </svg>
                <p class="toast-text">@success</p>
                <button type="button" class="toast-close" data-action="dismiss-toast" aria-label="Dismiss message">&times;</button>
            </div>
        }
    </div>
}
