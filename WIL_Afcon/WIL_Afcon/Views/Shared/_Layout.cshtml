<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - WIL_Afcon</title>

    <!-- Tailwind / DaisyUI -->
    <link rel="stylesheet"
          href="~/css/output.css"
          asp-append-version="true" />

    <!-- Project CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="m-0 bg-[#f5f7fc]">

    <main role="main">
        @RenderBody()
    </main>


    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>