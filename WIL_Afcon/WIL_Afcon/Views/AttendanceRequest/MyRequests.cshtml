@model List<WIL_Afcon.Models.AttendanceRequest>

@{
    ViewData["Title"] = "My Attendance Requests";
}

<h1>My Attendance Requests</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Create Request
    </a>
</p>

@if (Model == null || !Model.Any())
{
    <p>You have not submitted any attendance requests.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Request Type</th>
                <th>Request Date</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.RequestType</td>

                    <td>
                        @request.RequestDate.ToShortDateString()
                    </td>

                    <td>
                        @(request.StartDate?.ToShortDateString() ?? "N/A")
                    </td>

                    <td>
                        @(request.EndDate?.ToShortDateString() ?? "N/A")
                    </td>

                    <td>
                        @request.Status
                    </td>

                    <td>
                        @(string.IsNullOrWhiteSpace(request.Description)
                            ? "No description"
                            : request.Description)
                    </td>

                    <td>
                        <a asp-action="MyDetails"
                           asp-route-id="@request.Id"
                           class="btn btn-sm btn-secondary">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}