@model List<WIL_Afcon.Models.AttendanceRequest>

@{
    ViewData["Title"] = "My Requests";

    var totalRequests = Model?.Count ?? 0;

    var pendingRequests = Model?.Count(r =>
        r.Status.ToString() == "Pending") ?? 0;

    var acceptedRequests = Model?.Count(r =>
        r.Status.ToString() == "Accepted") ?? 0;

    var rejectedRequests = Model?.Count(r =>
        r.Status.ToString() == "Rejected") ?? 0;
}

<div class="min-h-screen bg-[#f5f7fc] lg:flex">

    <!-- ====================================================== -->
    <!-- EMPLOYEE SIDEBAR                                       -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:z-30 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>

                </svg>

            </div>

            <div>
                <p class="text-base font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Employee Portal
                </p>
            </div>

        </div>


        <!-- SIDEBAR CONTENT -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <!-- NAVIGATION -->
            <nav class="flex-1 overflow-y-auto px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-400">
                    Employee
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Employee"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                    </svg>

                    <span>Dashboard</span>

                </a>


                <!-- MY ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="MyAttendance"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 2"></path>

                    </svg>

                    <span>My Attendance</span>

                </a>


                <!-- MY ATTENDANCE REPORT -->
                <a asp-controller="AttendanceReport"
                   asp-action="MyReport"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M4 19V9"></path>
                        <path d="M10 19V5"></path>
                        <path d="M16 19v-7"></path>
                        <path d="M22 19V3"></path>

                    </svg>

                    <span>My Attendance Report</span>

                </a>


                <!-- MY REQUESTS - ACTIVE -->
                <a asp-controller="AttendanceRequest"
                   asp-action="MyRequests"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                    </svg>

                    <span>My Requests</span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary"></span>

                </a>


                <!-- MY DOCUMENTS -->
                <a asp-controller="Document"
                   asp-action="MyDocuments"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                        <path d="M14 2v6h6"></path>
                        <path d="M8 13h8"></path>
                        <path d="M8 17h5"></path>

                    </svg>

                    <span>My Documents</span>

                </a>


                <!-- NEW REQUEST -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Create"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v8"></path>
                        <path d="M8 12h8"></path>

                    </svg>

                    <span>New Request</span>

                </a>


                <!-- MY PROFILE -->
                <a asp-controller="Employee"
                   asp-action="Profile"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 21a8 8 0 0 1 16 0"></path>

                    </svg>

                    <span>My Profile</span>

                </a>

            </nav>


            <!-- SIGN OUT -->
            <div class="border-t border-slate-200 p-5">

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5 shrink-0">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21"
                                  x2="9"
                                  y1="12"
                                  y2="12">
                            </line>

                        </svg>

                        <span>Sign Out</span>

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">

        <main id="main-content" tabindex="-1" class="mx-auto max-w-7xl p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- PAGE HEADER                                        -->
            <!-- ================================================== -->

            <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                <div>

                    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                        My Requests
                    </h1>

                    <p class="mt-1 text-sm text-slate-500">
                        View and manage your attendance requests.
                    </p>

                </div>


                <!-- CREATE REQUEST -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Create"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-content no-underline shadow-sm transition hover:opacity-90">

                    <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-4 w-4">

                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>

                    </svg>

                    Create Request

                </a>

            </div>


            <!-- ================================================== -->
            <!-- SUMMARY CARDS                                      -->
            <!-- ================================================== -->

            <section class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">


                <!-- TOTAL -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm font-medium text-slate-500">
                                Total Requests
                            </p>

                            <p class="mt-3 text-3xl font-bold text-slate-900">
                                @totalRequests
                            </p>

                        </div>


                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="M9 11l3 3L22 4"></path>
                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                            </svg>

                        </div>

                    </div>

                </div>


                <!-- PENDING -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm font-medium text-slate-500">
                                Pending
                            </p>

                            <p class="mt-3 text-3xl font-bold text-slate-900">
                                @pendingRequests
                            </p>

                        </div>


                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-600">

                            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 7v5l3 2"></path>

                            </svg>

                        </div>

                    </div>

                </div>


                <!-- ACCEPTED -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm font-medium text-slate-500">
                                Accepted
                            </p>

                            <p class="mt-3 text-3xl font-bold text-slate-900">
                                @acceptedRequests
                            </p>

                        </div>


                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-50 text-green-600">

                            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="m8 12 2.5 2.5L16 9"></path>

                            </svg>

                        </div>

                    </div>

                </div>


                <!-- REJECTED -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm font-medium text-slate-500">
                                Rejected
                            </p>

                            <p class="mt-3 text-3xl font-bold text-slate-900">
                                @rejectedRequests
                            </p>

                        </div>


                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-red-50 text-red-600">

                            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="m9 9 6 6"></path>
                                <path d="m15 9-6 6"></path>

                            </svg>

                        </div>

                    </div>

                </div>

            </section>


            <!-- ================================================== -->
            <!-- REQUEST HISTORY                                    -->
            <!-- ================================================== -->

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                <div class="border-b border-slate-200 px-6 py-5">

                    <h2 class="text-lg font-bold text-slate-900">
                        Request History
                    </h2>

                    <p class="mt-1 text-xs text-slate-500">
                        Track the status of your submitted requests.
                    </p>

                </div>


                @if (Model == null || !Model.Any())
                {
                    <!-- EMPTY STATE -->
                    <div class="px-6 py-16 text-center">

                        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-6 w-6">

                                <path d="M9 11l3 3L22 4"></path>
                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                            </svg>

                        </div>


                        <h3 class="mt-4 font-semibold text-slate-900">
                            No requests submitted
                        </h3>

                        <p class="mt-1 text-sm text-slate-500">
                            You have not submitted any attendance requests yet.
                        </p>


                        <a asp-controller="AttendanceRequest"
                           asp-action="Create"
                           class="mt-5 inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-content no-underline transition hover:opacity-90">

                            Create Your First Request

                        </a>

                    </div>
                }
                else
                {
                    <div class="w-full">

                        <table class="w-full table-fixed text-left">

                            <thead class="bg-slate-50">

                                <tr class="border-b border-slate-200 text-xs font-semibold uppercase tracking-wide text-slate-500">

                                    <th class="w-[14%] px-4 py-4">
                                        Type
                                    </th>

                                    <th class="w-[13%] px-3 py-4">
                                        Request Date
                                    </th>

                                    <th class="w-[12%] px-3 py-4">
                                        Start Date
                                    </th>

                                    <th class="w-[12%] px-3 py-4">
                                        End Date
                                    </th>

                                    <th class="w-[12%] px-3 py-4">
                                        Status
                                    </th>

                                    <th class="w-[27%] px-3 py-4">
                                        Description
                                    </th>

                                    <th class="w-[10%] px-3 py-4 text-right">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody class="divide-y divide-slate-100">

                                @foreach (var request in Model)
                                {
                                    var statusClass =
                                        request.Status.ToString() switch
                                        {
                                            "Pending"
                                                => "bg-amber-50 text-amber-700 ring-amber-200",

                                            "Accepted"
                                                => "bg-green-50 text-green-700 ring-green-200",

                                            "Rejected"
                                                => "bg-red-50 text-red-700 ring-red-200",

                                            _ => "bg-slate-100 text-slate-700 ring-slate-200"
                                        };


                                    <tr class="transition hover:bg-slate-50">

                                        <!-- TYPE -->
                                        <td class="px-4 py-4">

                                            <span class="text-sm font-semibold text-slate-900">
                                                @request.RequestType
                                            </span>

                                        </td>


                                        <!-- REQUEST DATE -->
                                        <td class="px-3 py-4 text-sm text-slate-600">

                                            @request.RequestDate.ToString("dd MMM yyyy")

                                        </td>


                                        <!-- START DATE -->
                                        <td class="px-3 py-4 text-sm text-slate-600">

                                            @(request.StartDate?.ToString("dd MMM yyyy")
                                                ?? "N/A")

                                        </td>


                                        <!-- END DATE -->
                                        <td class="px-3 py-4 text-sm text-slate-600">

                                            @(request.EndDate?.ToString("dd MMM yyyy")
                                                ?? "N/A")

                                        </td>


                                        <!-- STATUS -->
                                        <td class="px-3 py-4">

                                            <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @statusClass">

                                                @request.Status

                                            </span>

                                        </td>


                                        <!-- DESCRIPTION -->
                                        <td class="px-3 py-4">

                                            <p class="truncate text-sm text-slate-600"
                                               title="@request.Description">

                                                @(string.IsNullOrWhiteSpace(request.Description)
                                                    ? "No description"
                                                    : request.Description)

                                            </p>

                                        </td>


                                        <!-- DETAILS -->
                                        <td class="px-3 py-4 text-right">

                                            <a asp-action="MyDetails"
                                               asp-route-id="@request.Id"
                                               class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 no-underline transition hover:border-primary hover:text-primary">

                                                Details

                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>


            <!-- ================================================== -->
            <!-- INFORMATION                                        -->
            <!-- ================================================== -->

            <div class="mt-6 flex gap-3 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4">

                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="mt-0.5 h-5 w-5 shrink-0 text-primary">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 11v5"></path>
                    <path d="M12 8h.01"></path>

                </svg>


                <div>

                    <p class="text-sm font-semibold text-slate-800">
                        Attendance Requests
                    </p>

                    <p class="mt-1 text-xs leading-5 text-slate-600">
                        Submit a request if you need to record leave
                        or a late arrival. You can return to this page
                        to view the status of your request.
                    </p>

                </div>

            </div>

        </main>

    </div>

</div>