@using Microsoft.AspNetCore.Mvc.Rendering
@model WIL_Afcon.Models.ViewModels.AttendanceReportViewModel?

@{
    ViewData["Title"] = "My Attendance Report";

    var years =
        ViewBag.Years as List<SelectListItem>
        ?? new List<SelectListItem>();

    var months =
        ViewBag.Months as List<SelectListItem>
        ?? new List<SelectListItem>();
}

<style>
    @@media print {

        .no-print,
        .employee-sidebar {
            display: none !important;
        }

        .report-main {
            margin-left: 0 !important;
            padding: 0 !important;
        }

        body {
            background: white !important;
        }
    }
</style>


<div class="min-h-screen bg-[#f5f7fc] lg:flex">

    <!-- ====================================================== -->
    <!-- EMPLOYEE SIDEBAR                                       -->
    <!-- ====================================================== -->

    <aside class="employee-sidebar w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:z-50 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 7v5l3 2">
                    </path>

                </svg>

            </div>

            <div>

                <p class="text-base font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Employee Portal
                </p>

            </div>

        </div>


        <!-- SIDEBAR CONTENT -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <nav class="flex-1 px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-400">
                    Employee
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Employee"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <rect x="3"
                              y="3"
                              width="7"
                              height="7"
                              rx="1">
                        </rect>

                        <rect x="14"
                              y="3"
                              width="7"
                              height="7"
                              rx="1">
                        </rect>

                        <rect x="3"
                              y="14"
                              width="7"
                              height="7"
                              rx="1">
                        </rect>

                        <rect x="14"
                              y="14"
                              width="7"
                              height="7"
                              rx="1">
                        </rect>

                    </svg>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- MY ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="MyAttendance"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12"
                                cy="12"
                                r="9">
                        </circle>

                        <path d="M12 7v5l3 2">
                        </path>

                    </svg>

                    <span>
                        My Attendance
                    </span>

                </a>


                <!-- MY ATTENDANCE REPORT - ACTIVE -->
                <a asp-action="MyReport"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M4 19V9">
                        </path>

                        <path d="M10 19V5">
                        </path>

                        <path d="M16 19v-7">
                        </path>

                        <path d="M22 19V3">
                        </path>

                    </svg>

                    <span>
                        My Attendance Report
                    </span>

                    <span class="ml-auto h-2 w-2 shrink-0 rounded-full bg-primary">
                    </span>

                </a>


                <!-- MY REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="MyRequests"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M9 11l3 3L22 4">
                        </path>

                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11">
                        </path>

                    </svg>

                    <span>
                        My Requests
                    </span>

                </a>


                <!-- MY DOCUMENTS -->
                <a asp-controller="Document"
                   asp-action="MyDocuments"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z">
                        </path>

                        <path d="M14 2v6h6">
                        </path>

                        <path d="M8 13h8">
                        </path>

                        <path d="M8 17h5">
                        </path>

                    </svg>

                    <span>
                        My Documents
                    </span>

                </a>


                <!-- NEW REQUEST -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Create"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12"
                                cy="12"
                                r="9">
                        </circle>

                        <path d="M12 8v8">
                        </path>

                        <path d="M8 12h8">
                        </path>

                    </svg>

                    <span>
                        New Request
                    </span>

                </a>

            </nav>


            <!-- SIGN OUT -->
            <div class="border-t border-slate-200 p-5">

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5 shrink-0">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4">
                            </path>

                            <polyline points="16 17 21 12 16 7">
                            </polyline>

                            <line x1="21"
                                  x2="9"
                                  y1="12"
                                  y2="12">
                            </line>

                        </svg>

                        <span>
                            Sign Out
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="report-main min-w-0 flex-1 lg:ml-72">

        <main class="mx-auto max-w-7xl p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- PAGE HEADER                                        -->
            <!-- ================================================== -->

            <div class="no-print mb-7">

                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    My Attendance Report
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Generate and download your monthly attendance report.
                </p>

            </div>


            <!-- ================================================== -->
            <!-- REPORT FILTER                                      -->
            <!-- ================================================== -->

            <section class="no-print mb-6 rounded-2xl border border-slate-200 bg-white shadow-sm">

                <div class="border-b border-slate-200 px-6 py-5">

                    <div class="flex items-center gap-3">

                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="M4 19V9">
                                </path>

                                <path d="M10 19V5">
                                </path>

                                <path d="M16 19v-7">
                                </path>

                                <path d="M22 19V3">
                                </path>

                            </svg>

                        </div>


                        <div>

                            <h2 class="font-bold text-slate-900">
                                Generate Report
                            </h2>

                            <p class="mt-0.5 text-xs text-slate-500">
                                Select a year and month to view your attendance.
                            </p>

                        </div>

                    </div>

                </div>


                <form asp-action="MyReport"
                      method="get"
                      class="grid gap-5 p-6 md:grid-cols-[1fr_1fr_auto] md:items-end">

                    <!-- YEAR -->
                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Year
                        </label>

                        <select name="year"
                                asp-items="years"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20">
                        </select>

                    </div>


                    <!-- MONTH -->
                    <div>

                        <label class="mb-2 block text-sm font-semibold text-slate-700">
                            Month
                        </label>

                        <select name="month"
                                asp-items="months"
                                class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20">
                        </select>

                    </div>


                    <!-- GENERATE -->
                    <div>

                        <button type="submit"
                                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-content shadow-sm transition hover:opacity-90 md:w-auto">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-4 w-4">

                                <path d="M4 19V9">
                                </path>

                                <path d="M10 19V5">
                                </path>

                                <path d="M16 19v-7">
                                </path>

                                <path d="M22 19V3">
                                </path>

                            </svg>

                            Generate Report

                        </button>

                    </div>

                </form>

            </section>


            @if (Model == null)
            {
                <!-- ================================================== -->
                <!-- NO REPORT                                          -->
                <!-- ================================================== -->

                <section class="rounded-2xl border border-slate-200 bg-white px-6 py-16 text-center shadow-sm">

                    <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-6 w-6">

                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z">
                            </path>

                            <path d="M14 2v6h6">
                            </path>

                        </svg>

                    </div>


                    <h3 class="mt-4 font-semibold text-slate-900">
                        No report available
                    </h3>

                    <p class="mx-auto mt-1 max-w-md text-sm text-slate-500">
                        Select a year and month above to generate your attendance report.
                    </p>

                </section>
            }
            else
            {
                <!-- ================================================== -->
                <!-- REPORT ACTIONS                                     -->
                <!-- ================================================== -->

                <div class="no-print mb-5 flex flex-col gap-3 sm:flex-row sm:justify-end">

                    <!-- PRINT -->
                    <button type="button"
                            onclick="window.print()"
                            class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4">

                            <polyline points="6 9 6 2 18 2 18 9">
                            </polyline>

                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2">
                            </path>

                            <rect x="6"
                                  y="14"
                                  width="12"
                                  height="8">
                            </rect>

                        </svg>

                        Print / Save as PDF

                    </button>


                    <!-- CSV -->
                    <a asp-action="MyReportCsv"
                       asp-route-year="@Model.Year"
                       asp-route-month="@Model.Month"
                       class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-content no-underline shadow-sm transition hover:opacity-90">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4">

                            <path d="M12 3v12">
                            </path>

                            <path d="m7 10 5 5 5-5">
                            </path>

                            <path d="M5 21h14">
                            </path>

                        </svg>

                        Download Excel (CSV)

                    </a>

                </div>


                <!-- ================================================== -->
                <!-- REPORT                                             -->
                <!-- ================================================== -->

                <section class="min-w-0 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">

                    <partial name="_ReportSheet"
                             model="Model" />

                </section>
            }


            <!-- ================================================== -->
            <!-- INFORMATION                                        -->
            <!-- ================================================== -->

            <div class="no-print mt-6 flex gap-3 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="mt-0.5 h-5 w-5 shrink-0 text-primary">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 11v5">
                    </path>

                    <path d="M12 8h.01">
                    </path>

                </svg>


                <div>

                    <p class="text-sm font-semibold text-slate-800">
                        Attendance Reports
                    </p>

                    <p class="mt-1 text-xs leading-5 text-slate-600">
                        Your monthly attendance report can be printed,
                        saved as a PDF or downloaded as a CSV file.
                    </p>

                </div>

            </div>

        </main>

    </div>

</div>