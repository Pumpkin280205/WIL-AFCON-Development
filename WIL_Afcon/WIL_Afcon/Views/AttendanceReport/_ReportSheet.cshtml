@model WIL_Afcon.Models.ViewModels.AttendanceReportViewModel

@functions {
    private static string ShowTime(DateTime? value)
        => value.HasValue ? value.Value.ToString("HH:mm") : "";

    private static string ShowHours(double value, bool show)
        => show ? value.ToString("0.00") : "";
}

<style>
    /* ==========================================================
       SCREEN REPORT
       ========================================================== */

    .report-sheet {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow: hidden;
    }

    .report-table-scroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .attendance-register-table {
        width: 100%;
        min-width: 1250px;
        border-collapse: collapse;
        font-size: 0.78rem;
    }

    .attendance-register-table th,
    .attendance-register-table td {
        border: 1px solid #e2e8f0;
        padding: 8px 7px;
        vertical-align: middle;
        text-align: center;
    }

    .attendance-register-table thead th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 700;
        line-height: 1.25;
    }

    .attendance-register-table tbody td {
        color: #334155;
    }

    .attendance-register-table tfoot td {
        background-color: #f8fafc;
        color: #334155;
        font-weight: 700;
    }

    .report-sheet .row-weekend td {
        background-color: #f8fafc;
    }

    .report-sheet .row-holiday td {
        background-color: #fef3c7;
    }

    .report-sheet .signature-cell {
        min-width: 105px;
    }

    .report-sheet .remarks-cell {
        min-width: 110px;
        text-align: left;
    }

    .report-sheet .nowrap {
        white-space: nowrap;
    }

    /* Scrollbar only belongs to the report table */
    .report-table-scroll::-webkit-scrollbar {
        height: 8px;
    }

    .report-table-scroll::-webkit-scrollbar-track {
        background: #f1f5f9;
    }

    .report-table-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 9999px;
    }


    /* ==========================================================
       PRINT REPORT
       ========================================================== */

    @@media print {

        header,
        footer,
        .no-print {
            display: none !important;
        }

        html,
        body {
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            background: white !important;
            overflow: visible !important;
        }

        .report-sheet-container {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: visible !important;
        }

        .report-sheet {
            width: 100% !important;
            max-width: none !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
            overflow: visible !important;
        }

        .report-table-scroll {
            width: 100% !important;
            max-width: none !important;
            overflow: visible !important;
        }

        .attendance-register-table {
            width: 100% !important;
            min-width: 0 !important;
            table-layout: fixed !important;
            font-size: 6.5pt !important;
        }

        .attendance-register-table th,
        .attendance-register-table td {
            padding: 3px 2px !important;
            line-height: 1.15 !important;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .report-sheet .signature-cell,
        .report-sheet .remarks-cell {
            min-width: 0 !important;
        }

        .report-sheet .row-weekend td,
        .report-sheet .row-holiday td,
        .attendance-register-table thead th,
        .attendance-register-table tfoot td {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        .report-summary-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 20px !important;
        }

        .report-card {
            border: none !important;
            box-shadow: none !important;
        }

        @@page {
            size: A4 landscape;
            margin: 8mm;
        }
    }
</style>


<!-- ========================================================== -->
<!-- REPORT DOCUMENT                                            -->
<!-- ========================================================== -->

<div class="report-sheet overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


    <!-- ====================================================== -->
    <!-- REPORT HEADER                                         -->
    <!-- ====================================================== -->

    <div class="border-b border-slate-200 px-6 py-5 text-center">

        <h2 class="text-xl font-bold text-slate-900">
            Attendance Register
        </h2>

        <p class="mt-1 text-sm text-slate-500">
            Monthly Employee Attendance Report
        </p>

    </div>


    <!-- ====================================================== -->
    <!-- EMPLOYEE INFORMATION                                  -->
    <!-- ====================================================== -->

    <div class="grid border-b border-slate-200 md:grid-cols-2">


        <!-- EMPLOYEE NAME -->
        <div class="border-b border-slate-200 px-6 py-4 md:border-r">

            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Employee Name
            </p>

            <p class="mt-1.5 text-sm font-semibold text-slate-900">
                @Model.EmployeeName
            </p>

        </div>


        <!-- EMPLOYEE NUMBER -->
        <div class="border-b border-slate-200 px-6 py-4">

            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Employee No.
            </p>

            <p class="mt-1.5 text-sm font-semibold text-slate-900">
                @Model.EmployeeNumber
            </p>

        </div>


        <!-- DEPARTMENT -->
        <div class="px-6 py-4 md:border-r">

            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Department
            </p>

            <p class="mt-1.5 text-sm font-semibold text-slate-900">
                @Model.DepartmentName
            </p>

        </div>


        <!-- REPORTING PERIOD -->
        <div class="px-6 py-4">

            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Reporting Period
            </p>

            <p class="mt-1.5 text-sm font-semibold text-slate-900">
                @Model.MonthName @Model.Year
            </p>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- ATTENDANCE REGISTER                                   -->
    <!-- ====================================================== -->

    <div class="p-5">

        <div class="mb-3 flex items-center justify-between gap-4">

            <div>

                <h3 class="text-sm font-semibold text-slate-900">
                    Daily Attendance
                </h3>

                <p class="mt-0.5 text-xs text-slate-500">
                    Daily working times and calculated attendance hours.
                </p>

            </div>

            <!-- Visible on screen only -->
            <div class="no-print hidden items-center gap-1.5 text-xs text-slate-400 lg:flex">

                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-4 w-4">
                    <path d="m9 18-6-6 6-6"></path>
                    <path d="m15 6 6 6-6 6"></path>
                </svg>

                Scroll table to view all columns

            </div>

        </div>


        <!-- IMPORTANT:
             Horizontal scrolling is restricted to this div.
             It will no longer make the whole website wider. -->

        <div class="report-table-scroll rounded-xl border border-slate-200">

            <table class="attendance-register-table">

                <thead>

                    <tr>

                        <th rowspan="2">
                            Day
                        </th>

                        <th rowspan="2">
                            Day of the Week
                        </th>

                        <th rowspan="2">
                            Starting Time
                        </th>

                        <th colspan="2">
                            Meal Intervals
                        </th>

                        <th rowspan="2">
                            Finishing Time
                        </th>

                        <th colspan="2">
                            Total Number of Hours Worked
                        </th>

                        <th>
                            Overtime Worked
                        </th>

                        <th>
                            Sundays Worked
                        </th>

                        <th>
                            Public Holidays Worked
                        </th>

                        <th rowspan="2">
                            Remarks
                        </th>

                        <th rowspan="2"
                            class="signature-cell">
                            Signature
                        </th>

                    </tr>


                    <tr>

                        <th>
                            Off
                        </th>

                        <th>
                            On
                        </th>

                        <th>
                            Each Day
                        </th>

                        <th>
                            Each Week
                        </th>

                        <th>
                            Total Hours
                        </th>

                        <th>
                            Total Hours
                        </th>

                        <th>
                            Total Hours
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var d in Model.Days)
                    {
                        var rowClass = d.IsPublicHoliday
                            ? "row-holiday"
                            : (d.IsSaturday || d.IsSunday ? "row-weekend" : "");

                        <tr class="@rowClass">


                            <!-- DAY -->
                            <td class="nowrap">
                                @d.DayNumber
                            </td>


                            <!-- DAY OF WEEK -->
                            <td class="nowrap">
                                @d.DayOfWeekName
                            </td>


                            <!-- START -->
                            <td class="nowrap">
                                @ShowTime(d.StartingTime)
                            </td>


                            <!-- MEAL OFF -->
                            <td class="nowrap">
                                @ShowTime(d.MealOff)
                            </td>


                            <!-- MEAL ON -->
                            <td class="nowrap">
                                @ShowTime(d.MealOn)
                            </td>


                            <!-- FINISH -->
                            <td class="nowrap">
                                @ShowTime(d.FinishingTime)
                            </td>


                            <!-- HOURS EACH DAY -->
                            <td class="nowrap">
                                @ShowHours(d.HoursWorked, d.HasRecord)
                            </td>


                            <!-- HOURS EACH WEEK -->
                            <td class="nowrap font-semibold">
                                @(d.WeekTotalHours.HasValue
                                    ? d.WeekTotalHours.Value.ToString("0.00")
                                    : "")
                            </td>


                            <!-- OVERTIME -->
                            <td class="nowrap">
                                @ShowHours(
                                    d.OvertimeHours,
                                    d.OvertimeHours > 0)
                            </td>


                            <!-- SUNDAY -->
                            <td class="nowrap">
                                @ShowHours(
                                    d.SundayHours,
                                    d.SundayHours > 0)
                            </td>


                            <!-- PUBLIC HOLIDAY -->
                            <td class="nowrap">
                                @ShowHours(
                                    d.PublicHolidayHours,
                                    d.PublicHolidayHours > 0)
                            </td>


                            <!-- REMARKS -->
                            <td class="remarks-cell">
                                @d.Remarks
                            </td>


                            <!-- SIGNATURE -->
                            <td class="signature-cell">
                            </td>

                        </tr>
                    }

                </tbody>


                <!-- ================================================== -->
                <!-- MONTH TOTALS                                       -->
                <!-- ================================================== -->

                <tfoot>

                    <tr>

                        <td colspan="6"
                            class="text-right">
                            Total Number of Hours Worked for Month:
                        </td>

                        <td colspan="2">
                            @Model.TotalHoursWorked.ToString("0.00")
                        </td>

                        <td>
                            @Model.TotalOvertimeHours.ToString("0.00")
                        </td>

                        <td>
                            @Model.TotalSundayHours.ToString("0.00")
                        </td>

                        <td>
                            @Model.TotalPublicHolidayHours.ToString("0.00")
                        </td>

                        <td colspan="2">
                        </td>

                    </tr>

                </tfoot>

            </table>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- MONTHLY SUMMARY                                       -->
    <!-- ====================================================== -->

    <div class="report-summary-grid grid gap-6 border-t border-slate-200 p-6 lg:grid-cols-2">


        <!-- SUMMARY -->
        <div>

            <h3 class="mb-4 text-sm font-semibold text-slate-900">
                Monthly Summary
            </h3>


            <div class="overflow-hidden rounded-xl border border-slate-200">


                <!-- PRESENT -->
                <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">

                    <div class="flex items-center gap-2">

                        <span class="h-2 w-2 rounded-full bg-green-500"></span>

                        <span class="text-sm font-medium text-slate-600">
                            Days Present
                        </span>

                    </div>

                    <span class="text-sm font-bold text-slate-900">
                        @Model.DaysPresent
                    </span>

                </div>


                <!-- LATE -->
                <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">

                    <div class="flex items-center gap-2">

                        <span class="h-2 w-2 rounded-full bg-amber-500"></span>

                        <span class="text-sm font-medium text-slate-600">
                            Days Late
                        </span>

                    </div>

                    <span class="text-sm font-bold text-slate-900">
                        @Model.DaysLate
                    </span>

                </div>


                <!-- ABSENT -->
                <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">

                    <div class="flex items-center gap-2">

                        <span class="h-2 w-2 rounded-full bg-red-500"></span>

                        <span class="text-sm font-medium text-slate-600">
                            Days Absent
                        </span>

                    </div>

                    <span class="text-sm font-bold text-slate-900">
                        @Model.DaysAbsent
                    </span>

                </div>


                <!-- LEAVE -->
                <div class="flex items-center justify-between px-4 py-3">

                    <div class="flex items-center gap-2">

                        <span class="h-2 w-2 rounded-full bg-blue-500"></span>

                        <span class="text-sm font-medium text-slate-600">
                            Days On Leave
                        </span>

                    </div>

                    <span class="text-sm font-bold text-slate-900">
                        @Model.DaysOnLeave
                    </span>

                </div>

            </div>

        </div>


        <!-- SIGNATURES -->
        <div>

            <h3 class="mb-4 text-sm font-semibold text-slate-900">
                Approval
            </h3>


            <div class="rounded-xl border border-slate-200 p-5">


                <!-- EMPLOYEE SIGNATURE -->
                <div class="mb-7">

                    <p class="mb-5 text-xs font-semibold uppercase tracking-wide text-slate-400">
                        Employee Signature
                    </p>

                    <div class="border-b border-slate-300"></div>

                </div>


                <!-- MANAGER SIGNATURE -->
                <div class="mb-7">

                    <p class="mb-5 text-xs font-semibold uppercase tracking-wide text-slate-400">
                        Manager Signature
                    </p>

                    <div class="border-b border-slate-300"></div>

                </div>


                <!-- DATE -->
                <div>

                    <p class="mb-5 text-xs font-semibold uppercase tracking-wide text-slate-400">
                        Date
                    </p>

                    <div class="border-b border-slate-300"></div>

                </div>

            </div>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- REPORT NOTE                                           -->
    <!-- ====================================================== -->

    <div class="border-t border-slate-200 bg-slate-50 px-6 py-4">

        <p class="text-xs leading-5 text-slate-500">

            Overtime = hours worked above
            @Model.StandardDailyHours.ToString("0.##")
            per day (Monday &ndash; Saturday).

            Hours worked on Sundays and public holidays are shown in their own columns.

            Hours only count once the employee has clocked out.

            Generated
            @Model.GeneratedOn.ToString("yyyy/MM/dd HH:mm").

        </p>

    </div>

</div>