@model WIL_Afcon.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Employee Registration";
}

<main id="main-content" tabindex="-1" class="min-h-screen bg-slate-50">

    <div class="flex min-h-screen flex-col items-center justify-center px-6 py-10">

        <!-- AFCON LOGO -->
        <a asp-controller="Home"
           asp-action="Index"
           class="mb-4 flex w-full justify-center no-underline">

            <img src="~/images/Afcon.png"
                 asp-append-version="true"
                 alt="Afcon Industrial Equipment"
                 class="block h-20 w-auto object-contain" />

        </a>


        <!-- TITLE -->
        <h1 class="text-2xl font-bold text-slate-900">
            Employee Registration
        </h1>

        <p class="mt-1 text-center text-sm text-slate-500">
            Create your account using the email address provided by your administrator.
        </p>


        <!-- REGISTRATION CARD -->
        <div class="mt-7 w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

            <form asp-action="Register" method="post">

                @Html.AntiForgeryToken()


                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly" role="alert"
                     class="mb-4 text-sm text-red-600">
                </div>


                <!-- EMAIL -->
                <div class="mb-5">

                    <label asp-for="Email"
                           class="mb-2 block text-sm font-medium text-slate-700">
                        Email
                        <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="Email"
                           type="email"
                           autocomplete="email"
                           placeholder="Enter your email"
                           class="w-full rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary/10" />

                    <span asp-validation-for="Email"
                          class="mt-1 block text-xs text-red-600">
                    </span>

                </div>


                <!-- PASSWORD -->
                <div class="mb-5">

                    <label asp-for="Password"
                           class="mb-2 block text-sm font-medium text-slate-700">
                        Password
                        <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="Password"
                           autocomplete="new-password"
                           placeholder="Create a password"
                           class="w-full rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary/10" />

                    <span asp-validation-for="Password"
                          class="mt-1 block text-xs text-red-600">
                    </span>

                </div>


                <!-- CONFIRM PASSWORD -->
                <div class="mb-6">

                    <label asp-for="ConfirmPassword"
                           class="mb-2 block text-sm font-medium text-slate-700">
                        Confirm Password
                        <span class="text-red-500">*</span>
                    </label>

                    <input asp-for="ConfirmPassword"
                           autocomplete="new-password"
                           placeholder="Confirm your password"
                           class="w-full rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-primary focus:ring-2 focus:ring-primary/10" />

                    <span asp-validation-for="ConfirmPassword"
                          class="mt-1 block text-xs text-red-600">
                    </span>

                </div>


                <!-- REGISTER BUTTON -->
                <button type="submit"
                        class="w-full rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-content shadow-sm transition hover:opacity-90">
                    Create Account
                </button>


                <!-- EXISTING ACCOUNT -->
                <div class="mt-5 text-center">

                    <span class="text-sm text-slate-500">
                        Already have an account?
                    </span>

                    <a asp-controller="Account"
                       asp-action="Login"
                       asp-route-role="Employee"
                       class="ml-1 text-sm font-semibold text-primary no-underline hover:underline">
                        Sign in
                    </a>

                </div>

            </form>

        </div>


        <!-- BACK TO HOME -->
        <a asp-controller="Home"
           asp-action="Index"
           class="mt-7 inline-flex items-center gap-2 text-sm text-slate-500 no-underline transition hover:text-primary">

            <svg xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="h-4 w-4">

                <path d="M19 12H5"></path>
                <path d="m11 18-6-6 6-6"></path>

            </svg>

            Back to home

        </a>

    </div>

</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}