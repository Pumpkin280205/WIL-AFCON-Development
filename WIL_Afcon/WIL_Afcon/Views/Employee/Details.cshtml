@model WIL_Afcon.Models.Employee
@using WIL_Afcon.Models

@{
    ViewData["Title"] = "Employee Details";
    var documents = (List<Document>)ViewBag.Documents;

    var initials =
        $"{Model.FirstName.FirstOrDefault()}{Model.LastName.FirstOrDefault()}";
}

<div class="min-h-screen bg-[#f5f7fc] lg:flex">


    <!-- ====================================================== -->
    <!-- SIDEBAR                                                -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>

                </svg>

            </div>

            <div>
                <p class="font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Admin Panel
                </p>
            </div>

        </div>


        <!-- NAVIGATION -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <nav class="flex-1 px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-500">
                    Administration
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                    </svg>

                    Dashboard

                </a>


                <!-- EMPLOYEES - ACTIVE -->
                <a asp-controller="Employee"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>

                    </svg>

                    <span>Employees</span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary"></span>

                </a>


                <!-- DEPARTMENTS -->
                <a asp-controller="Department"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                        <path d="M9 22v-4h6v4"></path>
                        <path d="M8 6h.01"></path>
                        <path d="M12 6h.01"></path>
                        <path d="M16 6h.01"></path>

                    </svg>

                    Departments

                </a>


                <!-- ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M8 2v4"></path>
                        <path d="M16 2v4"></path>
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <path d="M3 10h18"></path>

                    </svg>

                    Attendance

                </a>


                <!-- REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                    </svg>

                    Requests

                </a>


                <!-- REPORTS -->
                <a asp-controller="AttendanceReport"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M3 3v18h18"></path>
                        <path d="m7 16 4-4 4 4 5-6"></path>

                    </svg>

                    Reports

                </a>

            </nav>


            <!-- SIDEBAR BOTTOM -->
            <div class="border-t border-slate-200 p-5">

                <div class="mb-4 flex items-center gap-3">

                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary font-semibold text-primary-content">
                        A
                    </div>

                    <div>
                        <p class="text-sm font-semibold text-slate-900">
                            Administrator
                        </p>

                        <p class="text-xs text-slate-500">
                            Admin
                        </p>
                    </div>

                </div>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" x2="9" y1="12" y2="12"></line>

                        </svg>

                        Sign Out

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">

        <main class="p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- PAGE HEADER                                       -->
            <!-- ================================================== -->

            <div class="mb-7 flex flex-col justify-between gap-5 lg:flex-row lg:items-end">


                <div>

                    <!-- BACK -->
                    <a asp-action="Index"
                       class="mb-4 inline-flex items-center gap-2 text-sm font-medium text-slate-500 no-underline transition hover:text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4">

                            <path d="M19 12H5"></path>
                            <path d="m11 18-6-6 6-6"></path>

                        </svg>

                        Back to Employees

                    </a>


                    <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                        Employee Details
                    </h1>

                    <p class="mt-1 text-sm text-slate-500">
                        View employee information and manage employee documents.
                    </p>

                </div>


                <!-- UPLOAD DOCUMENT -->
                <a asp-controller="Document"
                   asp-action="Upload"
                   asp-route-employeeId="@Model.Id"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-primary-content no-underline shadow-sm transition hover:opacity-90">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">

                        <path d="M12 3v12"></path>
                        <path d="m7 8 5-5 5 5"></path>
                        <path d="M5 21h14a2 2 0 0 0 2-2v-4"></path>
                        <path d="M3 15v4a2 2 0 0 0 2 2"></path>

                    </svg>

                    Upload Payslip / IRP5

                </a>

            </div>


            <!-- ================================================== -->
            <!-- EMPLOYEE PROFILE                                  -->
            <!-- ================================================== -->

            <div class="mb-6 grid gap-6 xl:grid-cols-[320px_1fr]">


                <!-- PROFILE CARD -->
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

                    <div class="text-center">

                        <!-- INITIALS -->
                        <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-primary/10 text-2xl font-bold uppercase text-primary">
                            @initials
                        </div>


                        <!-- NAME -->
                        <h2 class="mt-4 text-xl font-bold text-slate-900">
                            @Model.FirstName @Model.LastName
                        </h2>


                        <!-- EMPLOYEE NUMBER -->
                        <p class="mt-1 text-sm text-slate-500">
                            @Model.EmployeeNumber
                        </p>


                        <!-- STATUS -->
                        <div class="mt-4">

                            @if (Model.IsActive)
                            {
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-green-700 ring-1 ring-green-200">

                                    <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>

                                    Active

                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500 ring-1 ring-slate-200">

                                    <span class="h-1.5 w-1.5 rounded-full bg-slate-400"></span>

                                    Inactive

                                </span>
                            }

                        </div>

                    </div>


                    <div class="my-6 border-t border-slate-200"></div>


                    <!-- PROFILE SUMMARY -->
                    <div class="space-y-4">

                        <div>
                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Employee Number
                            </p>

                            <p class="mt-1 text-sm font-semibold text-slate-800">
                                @Model.EmployeeNumber
                            </p>
                        </div>


                        <div>
                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Email
                            </p>

                            <p class="mt-1 break-words text-sm font-medium text-slate-700">
                                @Model.Email
                            </p>
                        </div>

                    </div>

                </div>


                <!-- ================================================== -->
                <!-- EMPLOYEE INFORMATION                              -->
                <!-- ================================================== -->

                <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">


                    <!-- CARD HEADER -->
                    <div class="border-b border-slate-200 px-6 py-5">

                        <h2 class="text-lg font-semibold text-slate-900">
                            Employee Information
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            Personal, contact and attendance device information.
                        </p>

                    </div>


                    <!-- INFORMATION -->
                    <div class="grid gap-x-8 gap-y-6 p-6 md:grid-cols-2">


                        <!-- FIRST NAME -->
                        <div>

                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                First Name
                            </p>

                            <p class="mt-2 text-sm font-medium text-slate-800">
                                @Model.FirstName
                            </p>

                        </div>


                        <!-- LAST NAME -->
                        <div>

                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Last Name
                            </p>

                            <p class="mt-2 text-sm font-medium text-slate-800">
                                @Model.LastName
                            </p>

                        </div>


                        <!-- EMAIL -->
                        <div>

                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Email Address
                            </p>

                            <p class="mt-2 break-words text-sm font-medium text-slate-800">
                                @Model.Email
                            </p>

                        </div>


                        <!-- PHONE -->
                        <div>

                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Phone Number
                            </p>

                            @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                            {
                                <p class="mt-2 text-sm font-medium text-slate-800">
                                    @Model.PhoneNumber
                                </p>
                            }
                            else
                            {
                                <p class="mt-2 text-sm text-slate-400">
                                    Not provided
                                </p>
                            }

                        </div>


                        <!-- DEPARTMENT -->
                        <div>

                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Department ID
                            </p>

                            <p class="mt-2 break-all text-sm font-medium text-slate-800">
                                @Model.DepartmentId
                            </p>

                        </div>


                        <!-- DEVICE USER ID -->
                        <div>

                            <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                                Device User ID
                            </p>

                            @if (!string.IsNullOrWhiteSpace(Model.DeviceUserId))
                            {
                                <span class="mt-2 inline-flex rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-600">
                                    @Model.DeviceUserId
                                </span>
                            }
                            else
                            {
                                <p class="mt-2 text-sm text-slate-400">
                                    Not assigned
                                </p>
                            }

                        </div>

                    </div>


                    <!-- EDIT -->
                    <div class="flex justify-end border-t border-slate-200 bg-slate-50 px-6 py-4">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 no-underline transition hover:border-primary/30 hover:text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-4 w-4">

                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path>

                            </svg>

                            Edit Employee

                        </a>

                    </div>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- DOCUMENTS                                         -->
            <!-- ================================================== -->

            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


                <!-- DOCUMENT HEADER -->
                <div class="flex flex-col justify-between gap-4 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center">

                    <div>

                        <h2 class="text-lg font-semibold text-slate-900">
                            Employee Documents
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            Payslips and IRP5 documents uploaded for this employee.
                        </p>

                    </div>


                    <span class="inline-flex w-fit rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
                        @documents.Count document@(documents.Count == 1 ? "" : "s")
                    </span>

                </div>


                @if (!documents.Any())
                {
                    <!-- EMPTY STATE -->
                    <div class="flex min-h-64 items-center justify-center px-6 py-10">

                        <div class="text-center">

                            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-slate-400">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     class="h-6 w-6">

                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="9" y1="13" x2="15" y2="13"></line>
                                    <line x1="9" y1="17" x2="15" y2="17"></line>

                                </svg>

                            </div>


                            <h3 class="mt-4 font-semibold text-slate-900">
                                No documents uploaded
                            </h3>

                            <p class="mt-1 text-sm text-slate-500">
                                No payslips or IRP5 documents have been uploaded for this employee yet.
                            </p>


                            <a asp-controller="Document"
                               asp-action="Upload"
                               asp-route-employeeId="@Model.Id"
                               class="mt-5 inline-flex items-center gap-2 rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-content no-underline">

                                Upload Document

                            </a>

                        </div>

                    </div>
                }
                else
                {
                    <!-- DOCUMENT TABLE -->
                    <div class="w-full">

                        <table class="w-full table-fixed text-left">

                            <thead class="bg-slate-50">

                                <tr class="border-b border-slate-200">

                                    <th class="w-[22%] px-6 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Type
                                    </th>

                                    <th class="w-[38%] px-4 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        File Name
                                    </th>

                                    <th class="w-[25%] px-4 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Uploaded
                                    </th>

                                    <th class="w-[15%] px-6 py-3.5 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody class="divide-y divide-slate-100">

                                @foreach (var document in documents)
                                {
                                    <tr class="transition hover:bg-slate-50">


                                        <!-- DOCUMENT TYPE -->
                                        <td class="px-6 py-4">

                                            <span class="inline-flex rounded-lg bg-primary/10 px-3 py-1.5 text-xs font-semibold text-primary">
                                                @document.DocumentType
                                            </span>

                                        </td>


                                        <!-- FILE NAME -->
                                        <td class="px-4 py-4">

                                            <div class="flex min-w-0 items-center gap-3">

                                                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">

                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         class="h-4 w-4">

                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                        <polyline points="14 2 14 8 20 8"></polyline>

                                                    </svg>

                                                </div>

                                                <p class="truncate text-sm font-medium text-slate-700"
                                                   title="@document.FileName">
                                                    @document.FileName
                                                </p>

                                            </div>

                                        </td>


                                        <!-- UPLOADED -->
                                        <td class="px-4 py-4 text-sm text-slate-600">
                                            @document.UploadedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                        </td>


                                        <!-- DOWNLOAD -->
                                        <td class="px-6 py-4">

                                            <div class="flex justify-end">

                                                <a asp-controller="Document"
                                                   asp-action="Download"
                                                   asp-route-id="@document.Id"
                                                   class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-600 no-underline transition hover:border-primary/30 hover:bg-primary/5 hover:text-primary">

                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         class="h-4 w-4">

                                                        <path d="M12 3v12"></path>
                                                        <path d="m7 10 5 5 5-5"></path>
                                                        <path d="M5 21h14"></path>

                                                    </svg>

                                                    Download

                                                </a>

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </main>

    </div>

</div>