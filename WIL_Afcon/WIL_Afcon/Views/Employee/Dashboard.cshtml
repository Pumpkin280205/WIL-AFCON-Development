@model WIL_Afcon.Models.Employee

@{
    ViewData["Title"] = "Employee Dashboard";

    var firstInitial = !string.IsNullOrWhiteSpace(Model.FirstName)
        ? Model.FirstName.Substring(0, 1).ToUpper()
        : "";

    var lastInitial = !string.IsNullOrWhiteSpace(Model.LastName)
        ? Model.LastName.Substring(0, 1).ToUpper()
        : "";

    var initials = firstInitial + lastInitial;

    var hour = DateTime.Now.Hour;

    var greeting = hour < 12
        ? "Good morning"
        : hour < 17
            ? "Good afternoon"
            : "Good evening";
}

<div class="min-h-screen bg-[#f5f7fc] lg:flex">

    <!-- ====================================================== -->
    <!-- EMPLOYEE SIDEBAR                                       -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:z-50 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>

                </svg>

            </div>

            <div>
                <p class="text-base font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Employee Portal
                </p>
            </div>

        </div>


        <!-- SIDEBAR CONTENT -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <!-- NAVIGATION -->
            <nav class="flex-1 overflow-y-auto px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-400">
                    Employee
                </p>


                <!-- DASHBOARD - ACTIVE -->
                <a asp-controller="Employee"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                    </svg>

                    <span>
                        Dashboard
                    </span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary"></span>

                </a>


                <!-- MY ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="MyAttendance"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 2"></path>

                    </svg>

                    <span>
                        My Attendance
                    </span>

                </a>


                <!-- MY ATTENDANCE REPORT -->
                <a asp-controller="AttendanceReport"
                   asp-action="MyReport"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M4 19V9"></path>
                        <path d="M10 19V5"></path>
                        <path d="M16 19v-7"></path>
                        <path d="M22 19V3"></path>

                    </svg>

                    <span>
                        My Attendance Report
                    </span>

                </a>


                <!-- MY REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="MyRequests"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                    </svg>

                    <span>
                        My Requests
                    </span>

                </a>


                <!-- MY DOCUMENTS -->
                <a asp-controller="Document"
                   asp-action="MyDocuments"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                        <path d="M14 2v6h6"></path>
                        <path d="M8 13h8"></path>
                        <path d="M8 17h5"></path>

                    </svg>

                    <span>
                        My Documents
                    </span>

                </a>


                <!-- NEW REQUEST -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Create"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v8"></path>
                        <path d="M8 12h8"></path>

                    </svg>

                    <span>
                        New Request
                    </span>

                </a>


                <!-- MY PROFILE -->
                <a asp-controller="Employee"
                   asp-action="Profile"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 21a8 8 0 0 1 16 0"></path>

                    </svg>

                    <span>
                        My Profile
                    </span>

                </a>

            </nav>


            <!-- EMPLOYEE INFORMATION + SIGN OUT -->
            <div class="border-t border-slate-200 bg-white p-5">

                <div class="mb-4 flex items-center gap-3">

                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">
                        @initials
                    </div>

                    <div class="min-w-0">

                        <p class="truncate text-sm font-semibold text-slate-900">
                            @Model.FirstName @Model.LastName
                        </p>

                        <p class="truncate text-xs text-slate-500">
                            @Model.EmployeeNumber
                        </p>

                    </div>

                </div>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5 shrink-0">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21"
                                  x2="9"
                                  y1="12"
                                  y2="12">
                            </line>

                        </svg>

                        <span>
                            Sign Out
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">

        <main id="main-content" tabindex="-1" class="mx-auto max-w-7xl p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- HEADER                                             -->
            <!-- ================================================== -->

            <div class="mb-8">

                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    @greeting, @Model.FirstName
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    Welcome to your Afcon employee portal.
                </p>

            </div>


            <!-- ================================================== -->
            <!-- WELCOME CARD                                       -->
            <!-- ================================================== -->

            <section class="relative mb-6 overflow-hidden rounded-2xl bg-primary p-7 text-primary-content shadow-sm">

                <div class="absolute -right-16 -top-20 h-56 w-56 rounded-full bg-white/5"></div>

                <div class="absolute -bottom-24 right-20 h-48 w-48 rounded-full bg-white/5"></div>


                <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">

                    <div>

                        <p class="text-sm font-medium text-primary-content/70">
                            Employee Dashboard
                        </p>

                        <h2 class="mt-2 text-2xl font-bold">
                            @Model.FirstName @Model.LastName
                        </h2>

                        <p class="mt-2 text-sm text-primary-content/80">
                            Employee Number: @Model.EmployeeNumber
                        </p>

                    </div>


                    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-white/15 text-xl font-bold">
                        @initials
                    </div>

                </div>

            </section>


            <!-- ================================================== -->
            <!-- EMPLOYEE INFORMATION                               -->
            <!-- ================================================== -->

            <section class="mb-6 grid gap-4 md:grid-cols-3">


                <!-- EMPLOYEE NUMBER -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <rect x="3"
                                  y="5"
                                  width="18"
                                  height="14"
                                  rx="2">
                            </rect>

                            <circle cx="8"
                                    cy="10"
                                    r="2">
                            </circle>

                            <path d="M5.5 16c.7-1.7 4.3-1.7 5 0"></path>
                            <path d="M14 9h4"></path>
                            <path d="M14 13h4"></path>

                        </svg>

                    </div>

                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                        Employee Number
                    </p>

                    <p class="mt-2 text-lg font-bold text-slate-900">
                        @Model.EmployeeNumber
                    </p>

                </div>


                <!-- EMAIL -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <rect x="3"
                                  y="5"
                                  width="18"
                                  height="14"
                                  rx="2">
                            </rect>

                            <path d="m3 7 9 6 9-6"></path>

                        </svg>

                    </div>

                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                        Email Address
                    </p>

                    <p class="mt-2 truncate text-lg font-bold text-slate-900"
                       title="@Model.Email">
                        @Model.Email
                    </p>

                </div>


                <!-- STATUS -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">

                            <circle cx="12"
                                    cy="12"
                                    r="9">
                            </circle>

                            <path d="m8 12 2.5 2.5L16 9"></path>

                        </svg>

                    </div>

                    <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                        Account Status
                    </p>

                    <div class="mt-2">

                        @if (Model.IsActive)
                        {
                            <span class="inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-1.5 text-sm font-semibold text-green-700 ring-1 ring-inset ring-green-200">

                                <span class="h-2 w-2 rounded-full bg-green-500"></span>

                                Active

                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1.5 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-200">

                                <span class="h-2 w-2 rounded-full bg-red-500"></span>

                                Inactive

                            </span>
                        }

                    </div>

                </div>

            </section>


            <!-- ================================================== -->
            <!-- QUICK ACTIONS                                      -->
            <!-- ================================================== -->

            <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">

                <div class="border-b border-slate-200 px-6 py-5">

                    <h2 class="text-lg font-bold text-slate-900">
                        Quick Actions
                    </h2>

                    <p class="mt-1 text-xs text-slate-500">
                        Access your attendance, reports, requests, documents and profile.
                    </p>

                </div>


                <div class="grid gap-4 p-6 md:grid-cols-2 xl:grid-cols-3">


                    <!-- MY ATTENDANCE -->
                    <a asp-controller="Attendance"
                       asp-action="MyAttendance"
                       class="group flex items-center gap-4 rounded-xl border border-slate-200 p-4 no-underline transition hover:border-primary hover:bg-primary/5">

                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 7v5l3 2"></path>

                            </svg>

                        </div>

                        <div class="min-w-0 flex-1">

                            <p class="text-sm font-semibold text-slate-900 transition group-hover:text-primary">
                                My Attendance
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                View attendance history
                            </p>

                        </div>

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4 shrink-0 text-slate-400 transition group-hover:text-primary">

                            <path d="m9 18 6-6-6-6"></path>

                        </svg>

                    </a>


                    <!-- MY ATTENDANCE REPORT -->
                    <a asp-controller="AttendanceReport"
                       asp-action="MyReport"
                       class="group flex items-center gap-4 rounded-xl border border-slate-200 p-4 no-underline transition hover:border-primary hover:bg-primary/5">

                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="M4 19V9"></path>
                                <path d="M10 19V5"></path>
                                <path d="M16 19v-7"></path>
                                <path d="M22 19V3"></path>

                            </svg>

                        </div>

                        <div class="min-w-0 flex-1">

                            <p class="text-sm font-semibold text-slate-900 transition group-hover:text-primary">
                                Attendance Report
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                Generate monthly reports
                            </p>

                        </div>

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4 shrink-0 text-slate-400 transition group-hover:text-primary">

                            <path d="m9 18 6-6-6-6"></path>

                        </svg>

                    </a>


                    <!-- MY REQUESTS -->
                    <a asp-controller="AttendanceRequest"
                       asp-action="MyRequests"
                       class="group flex items-center gap-4 rounded-xl border border-slate-200 p-4 no-underline transition hover:border-primary hover:bg-primary/5">

                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="M9 11l3 3L22 4"></path>
                                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                            </svg>

                        </div>

                        <div class="min-w-0 flex-1">

                            <p class="text-sm font-semibold text-slate-900 transition group-hover:text-primary">
                                My Requests
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                Track submitted requests
                            </p>

                        </div>

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4 shrink-0 text-slate-400 transition group-hover:text-primary">

                            <path d="m9 18 6-6-6-6"></path>

                        </svg>

                    </a>


                    <!-- MY DOCUMENTS -->
                    <a asp-controller="Document"
                       asp-action="MyDocuments"
                       class="group flex items-center gap-4 rounded-xl border border-slate-200 p-4 no-underline transition hover:border-primary hover:bg-primary/5">

                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                                <path d="M14 2v6h6"></path>
                                <path d="M8 13h8"></path>
                                <path d="M8 17h5"></path>

                            </svg>

                        </div>

                        <div class="min-w-0 flex-1">

                            <p class="text-sm font-semibold text-slate-900 transition group-hover:text-primary">
                                My Documents
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                Download payslips &amp; IRP5s
                            </p>

                        </div>

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4 shrink-0 text-slate-400 transition group-hover:text-primary">

                            <path d="m9 18 6-6-6-6"></path>

                        </svg>

                    </a>


                    <!-- NEW REQUEST -->
                    <a asp-controller="AttendanceRequest"
                       asp-action="Create"
                       class="group flex items-center gap-4 rounded-xl border border-slate-200 p-4 no-underline transition hover:border-primary hover:bg-primary/5">

                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12" cy="12" r="9"></circle>
                                <path d="M12 8v8"></path>
                                <path d="M8 12h8"></path>

                            </svg>

                        </div>

                        <div class="min-w-0 flex-1">

                            <p class="text-sm font-semibold text-slate-900 transition group-hover:text-primary">
                                New Request
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                Submit attendance request
                            </p>

                        </div>

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4 shrink-0 text-slate-400 transition group-hover:text-primary">

                            <path d="m9 18 6-6-6-6"></path>

                        </svg>

                    </a>


                    <!-- MY PROFILE -->
                    <a asp-controller="Employee"
                       asp-action="Profile"
                       class="group flex items-center gap-4 rounded-xl border border-slate-200 p-4 no-underline transition hover:border-primary hover:bg-primary/5">

                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12" cy="8" r="4"></circle>
                                <path d="M4 21a8 8 0 0 1 16 0"></path>

                            </svg>

                        </div>

                        <div class="min-w-0 flex-1">

                            <p class="text-sm font-semibold text-slate-900 transition group-hover:text-primary">
                                My Profile
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                View employee information
                            </p>

                        </div>

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4 shrink-0 text-slate-400 transition group-hover:text-primary">

                            <path d="m9 18 6-6-6-6"></path>

                        </svg>

                    </a>

                </div>

            </section>


            <!-- ================================================== -->
            <!-- INFORMATION                                        -->
            <!-- ================================================== -->

            <div class="mt-6 flex gap-3 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="mt-0.5 h-5 w-5 shrink-0 text-primary">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 11v5"></path>
                    <path d="M12 8h.01"></path>

                </svg>

                <div>

                    <p class="text-sm font-semibold text-slate-800">
                        Employee Portal
                    </p>

                    <p class="mt-1 text-xs leading-5 text-slate-600">
                        Your attendance is recorded through the biometric
