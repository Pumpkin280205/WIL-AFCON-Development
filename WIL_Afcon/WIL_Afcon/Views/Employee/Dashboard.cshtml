@using WIL_Afcon.Models.Enums
@model WIL_Afcon.Models.ViewModels.EmployeeDashboardViewModel

@{
    ViewData["Title"] = "Employee Dashboard";

    var employee = Model.Employee;
    var today = Model.TodayAttendance;

    // =========================================================
    // EMPLOYEE INITIALS
    // =========================================================

    var firstInitial =
        !string.IsNullOrWhiteSpace(employee.FirstName)
            ? employee.FirstName.Substring(0, 1).ToUpper()
            : "";

    var lastInitial =
        !string.IsNullOrWhiteSpace(employee.LastName)
            ? employee.LastName.Substring(0, 1).ToUpper()
            : "";

    var initials =
        $"{firstInitial}{lastInitial}";


    // =========================================================
    // GREETING
    // =========================================================

    var hour = DateTime.Now.Hour;

    var greeting =
        hour < 12
            ? "Good morning"
            : hour < 18
                ? "Good afternoon"
                : "Good evening";


    // =========================================================
    // TODAY'S STATUS
    // =========================================================

    var status =
        today?.AttendanceStatus.ToString()
        ?? "Not Recorded";


    // =========================================================
    // MONTHLY HOURS
    // =========================================================

    var totalHours =
        Model.TotalMinutesThisMonth / 60;

    var totalMinutes =
        Model.TotalMinutesThisMonth % 60;


    // =========================================================
    // TODAY'S HOURS
    // =========================================================

    var todayHours =
        today?.WorkingMinutes / 60 ?? 0;

    var todayMinutes =
        today?.WorkingMinutes % 60 ?? 0;


    // =========================================================
    // TODAY'S BREAKS
    // =========================================================

    var todayBreakMinutes = 0;

    if (today != null)
    {
        foreach (var breakRecord in today.Breaks)
        {
            if (breakRecord.EndTime.HasValue)
            {
                todayBreakMinutes +=
                    (int)(
                        breakRecord.EndTime.Value
                        - breakRecord.StartTime
                    ).TotalMinutes;
            }
        }
    }


    // =========================================================
    // WEEKLY GRAPH MAXIMUM
    // =========================================================

    var maxWeeklyMinutes =
        Model.WeeklyMinutes.Count > 0
            ? Model.WeeklyMinutes.Values.Max()
            : 0;

    if (maxWeeklyMinutes < 1)
    {
        maxWeeklyMinutes = 1;
    }
}


<div class="min-h-screen bg-[#f5f7fc] lg:flex">


    <!-- ====================================================== -->
    <!-- EMPLOYEE SIDEBAR                                       -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:z-30 lg:w-72 lg:border-b-0 lg:border-r">


        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 7v5l3 2">
                    </path>

                </svg>

            </div>


            <div>

                <p class="text-base font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Employee Portal
                </p>

            </div>

        </div>


        <!-- SIDEBAR CONTENT -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">


            <!-- NAVIGATION -->
            <nav class="flex-1 px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-400">
                    Employee
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Employee"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <rect x="3"
                              y="3"
                              width="7"
                              height="7"
                              rx="1">
                        </rect>

                        <rect x="14"
                              y="3"
                              width="7"
                              height="7"
                              rx="1">
                        </rect>

                        <rect x="3"
                              y="14"
                              width="7"
                              height="7"
                              rx="1">
                        </rect>

                        <rect x="14"
                              y="14"
                              width="7"
                              height="7"
                              rx="1">
                        </rect>

                    </svg>

                    <span>
                        Dashboard
                    </span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary">
                    </span>

                </a>


                <!-- MY ATTENDANCE -->
                <a asp-controller="Attendance"
                   asp-action="MyAttendance"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12"
                                cy="12"
                                r="9">
                        </circle>

                        <path d="M12 7v5l3 2">
                        </path>

                    </svg>

                    <span>
                        My Attendance
                    </span>

                </a>


                <!-- MY REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="MyRequests"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M9 11l3 3L22 4">
                        </path>

                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11">
                        </path>

                    </svg>

                    <span>
                        My Requests
                    </span>

                </a>


                <!-- NEW REQUEST -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Create"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12"
                                cy="12"
                                r="9">
                        </circle>

                        <path d="M12 8v8">
                        </path>

                        <path d="M8 12h8">
                        </path>

                    </svg>

                    <span>
                        New Request
                    </span>

                </a>

            </nav>


            <!-- ================================================== -->
            <!-- EMPLOYEE ACCOUNT                                   -->
            <!-- ================================================== -->

            <div class="border-t border-slate-200 p-5">


                <div class="mb-4 flex items-center gap-3">


                    <!-- INITIALS -->
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary font-semibold text-primary-content">

                        @initials

                    </div>


                    <!-- EMPLOYEE DETAILS -->
                    <div class="min-w-0">

                        <p class="truncate text-sm font-semibold text-slate-900">
                            @employee.FirstName @employee.LastName
                        </p>

                        <p class="mt-0.5 text-xs text-slate-500">
                            @employee.EmployeeNumber
                        </p>

                    </div>

                </div>


                <!-- SIGN OUT -->
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5 shrink-0">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4">
                            </path>

                            <polyline points="16 17 21 12 16 7">
                            </polyline>

                            <line x1="21"
                                  x2="9"
                                  y1="12"
                                  y2="12">
                            </line>

                        </svg>

                        <span>
                            Sign Out
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </aside>



    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">

        <main class="mx-auto max-w-7xl p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- PAGE HEADER                                        -->
            <!-- ================================================== -->

            <div class="mb-7">

                <h1 class="text-3xl font-bold tracking-tight text-slate-900">

                    @greeting, @employee.FirstName 👋

                </h1>

                <p class="mt-1 text-sm text-slate-500">

                    @DateTime.Today.ToString(
                        "dddd, d MMMM yyyy")

                </p>

            </div>



            <!-- ================================================== -->
            <!-- TODAY'S STATUS                                     -->
            <!-- ================================================== -->

            <section class="mb-6 rounded-2xl bg-primary p-7 text-primary-content shadow-sm">


                <div class="mb-6 flex items-start justify-between gap-5">


                    <div>

                        <p class="text-sm font-medium opacity-75">
                            Today's Status
                        </p>

                        <h2 class="mt-1 text-3xl font-bold">
                            @status
                        </h2>

                    </div>


                    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white/15">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-7 w-7">

                            <circle cx="12"
                                    cy="12"
                                    r="9">
                            </circle>

                            <path d="m8 12 2.5 2.5L16 9">
                            </path>

                        </svg>

                    </div>

                </div>



                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">


                    <!-- CHECK IN -->
                    <div class="rounded-xl bg-white/10 p-4">

                        <p class="text-xs opacity-70">
                            Check In
                        </p>

                        <p class="mt-1 text-lg font-semibold">

                            @(today?.ClockInTime?.ToString("HH:mm")
                                ?? "--:--")

                        </p>

                    </div>


                    <!-- CHECK OUT -->
                    <div class="rounded-xl bg-white/10 p-4">

                        <p class="text-xs opacity-70">
                            Check Out
                        </p>

                        <p class="mt-1 text-lg font-semibold">

                            @(today?.ClockOutTime?.ToString("HH:mm")
                                ?? "--:--")

                        </p>

                    </div>


                    <!-- WORK HOURS -->
                    <div class="rounded-xl bg-white/10 p-4">

                        <p class="text-xs opacity-70">
                            Work Hours
                        </p>

                        <p class="mt-1 text-lg font-semibold">

                            @todayHours<span>h</span>
                            @todayMinutes<span>m</span>

                        </p>

                    </div>


                    <!-- BREAK TIME -->
                    <div class="rounded-xl bg-white/10 p-4">

                        <p class="text-xs opacity-70">
                            Break Time
                        </p>

                        <p class="mt-1 text-lg font-semibold">

                            @todayBreakMinutes min

                        </p>

                    </div>

                </div>

            </section>



            <!-- ================================================== -->
            <!-- TODAY'S BREAKS                                     -->
            <!-- ================================================== -->

            <section class="mb-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


                <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">

                    <h2 class="font-bold text-slate-900">
                        Today's Breaks
                    </h2>

                    <span class="text-sm text-slate-500">

                        @(today?.Breaks?.Count ?? 0)
                        break(s) ·
                        @todayBreakMinutes min total

                    </span>

                </div>


                @if (today != null &&
                     today.Breaks.Any())
                {
                    <div class="divide-y divide-slate-100">

                        @foreach (var breakRecord in today.Breaks)
                        {
                            var breakMinutes =
                                breakRecord.EndTime.HasValue
                                    ? (int)(
                                        breakRecord.EndTime.Value
                                        - breakRecord.StartTime
                                    ).TotalMinutes
                                    : 0;


                            <div class="flex items-center justify-between px-6 py-4">


                                <div class="flex items-center gap-3">

                                    <span class="h-2 w-2 rounded-full bg-primary">
                                    </span>

                                    <span class="text-sm font-medium text-slate-800">

                                        @breakRecord.StartTime.ToString("HH:mm")

                                        -

                                        @(breakRecord.EndTime?.ToString("HH:mm")
                                            ?? "In progress")

                                    </span>

                                </div>


                                <span class="text-sm text-slate-500">

                                    @(breakRecord.EndTime.HasValue
                                        ? $"{breakMinutes} min"
                                        : "Active")

                                </span>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="px-6 py-5 text-sm text-slate-500">

                        No breaks have been recorded today.

                    </div>
                }

            </section>



            <!-- ================================================== -->
            <!-- MONTHLY SUMMARY                                    -->
            <!-- ================================================== -->

            <section class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">


                <!-- DAYS PRESENT -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="flex items-start justify-between">

                        <div>

                            <p class="text-sm font-medium text-slate-500">
                                Days Present
                            </p>

                            <p class="mt-4 text-3xl font-bold text-slate-900">
                                @Model.DaysPresent
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                This month
                            </p>

                        </div>


                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-green-50 text-green-600">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12"
                                        cy="12"
                                        r="9">
                                </circle>

                                <path d="m8 12 2.5 2.5L16 9">
                                </path>

                            </svg>

                        </div>

                    </div>

                </div>



                <!-- DAYS ABSENT -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="flex items-start justify-between">

                        <div>

                            <p class="text-sm font-medium text-slate-500">
                                Days Absent
                            </p>

                            <p class="mt-4 text-3xl font-bold text-slate-900">
                                @Model.DaysAbsent
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                This month
                            </p>

                        </div>


                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-red-50 text-red-600">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12"
                                        cy="12"
                                        r="9">
                                </circle>

                                <path d="m9 9 6 6">
                                </path>

                                <path d="m15 9-6 6">
                                </path>

                            </svg>

                        </div>

                    </div>

                </div>



                <!-- LATE ARRIVALS -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="flex items-start justify-between">

                        <div>

                            <p class="text-sm font-medium text-slate-500">
                                Late Arrivals
                            </p>

                            <p class="mt-4 text-3xl font-bold text-slate-900">
                                @Model.LateArrivals
                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                This month
                            </p>

                        </div>


                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <path d="M12 9v4">
                                </path>

                                <path d="M12 17h.01">
                                </path>

                                <path d="M10.3 3.6 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z">
                                </path>

                            </svg>

                        </div>

                    </div>

                </div>



                <!-- TOTAL HOURS -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <div class="flex items-start justify-between">

                        <div>

                            <p class="text-sm font-medium text-slate-500">
                                Total Hours
                            </p>

                            <p class="mt-4 text-3xl font-bold text-slate-900">

                                @totalHours<span class="text-lg">h</span>

                                @totalMinutes<span class="text-lg">m</span>

                            </p>

                            <p class="mt-1 text-xs text-slate-500">
                                This month
                            </p>

                        </div>


                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-5 w-5">

                                <circle cx="12"
                                        cy="13"
                                        r="8">
                                </circle>

                                <path d="M12 9v4l2 2">
                                </path>

                                <path d="M9 2h6">
                                </path>

                            </svg>

                        </div>

                    </div>

                </div>

            </section>



            <!-- ================================================== -->
            <!-- WEEKLY HOURS                                       -->
            <!-- ================================================== -->

            <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">

                <h2 class="mb-7 text-lg font-bold text-slate-900">
                    Weekly Hours
                </h2>


                <div class="grid h-56 grid-cols-5 items-end gap-5">

                    @foreach (var day in Model.WeeklyMinutes)
                    {
                        var height =
                            day.Value == 0
                                ? 0
                                : Math.Max(
                                    8,
                                    (int)Math.Round(
                                        (double)day.Value
                                        / maxWeeklyMinutes
                                        * 100));


                        <div class="flex h-full flex-col justify-end">

                            <div class="flex flex-1 items-end justify-center">

                                <div class="w-10 rounded-t-lg bg-primary transition-all"
                                     style="height:@(height)%"
                                     title="@($"{day.Value / 60}h {day.Value % 60}m")">
                                </div>

                            </div>

                            <p class="mt-3 text-center text-sm text-slate-500">
                                @day.Key
                            </p>

                        </div>
                    }

                </div>

            </section>



            <!-- ================================================== -->
            <!-- RECENT ATTENDANCE                                  -->
            <!-- ================================================== -->

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


                <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">

                    <h2 class="text-lg font-bold text-slate-900">
                        Recent Attendance
                    </h2>

                    <a asp-controller="Attendance"
                       asp-action="MyAttendance"
                       class="text-sm font-semibold text-primary no-underline hover:underline">

                        View All →

                    </a>

                </div>


                @if (Model.RecentAttendance.Any())
                {
                    <div class="divide-y divide-slate-100">

                        @foreach (var attendance in Model.RecentAttendance)
                        {
                            var recordHours =
                                attendance.WorkingMinutes / 60;

                            var recordMinutes =
                                attendance.WorkingMinutes % 60;


                            var badgeClass =
                                attendance.AttendanceStatus switch
                                {
                                    AttendanceStatus.Present =>
                                        "bg-green-50 text-green-700 ring-green-200",

                                    AttendanceStatus.Late =>
                                        "bg-amber-50 text-amber-700 ring-amber-200",

                                    AttendanceStatus.Absent =>
                                        "bg-red-50 text-red-700 ring-red-200",

                                    AttendanceStatus.OnLeave =>
                                        "bg-blue-50 text-blue-700 ring-blue-200",

                                    AttendanceStatus.HalfDay =>
                                        "bg-purple-50 text-purple-700 ring-purple-200",

                                    _ =>
                                        "bg-slate-100 text-slate-700 ring-slate-200"
                                };


                            <div class="flex flex-col gap-4 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">


                                <div class="flex items-center gap-4">

                                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-500">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2"
                                             class="h-5 w-5">

                                            <rect x="3"
                                                  y="5"
                                                  width="18"
                                                  height="16"
                                                  rx="2">
                                            </rect>

                                            <path d="M16 3v4">
                                            </path>

                                            <path d="M8 3v4">
                                            </path>

                                            <path d="M3 11h18">
                                            </path>

                                        </svg>

                                    </div>


                                    <div>

                                        <p class="text-sm font-semibold text-slate-900">

                                            @attendance.AttendanceDate.ToString(
                                                "dd MMM yyyy")

                                        </p>


                                        <p class="mt-0.5 text-xs text-slate-500">

                                            @(attendance.ClockInTime?.ToString("HH:mm")
                                                ?? "--:--")

                                            <span class="mx-1">
                                                –
                                            </span>

                                            @(attendance.ClockOutTime?.ToString("HH:mm")
                                                ?? "--:--")

                                        </p>

                                    </div>

                                </div>


                                <div class="flex items-center gap-4 sm:justify-end">

                                    <span class="rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @badgeClass">

                                        @attendance.AttendanceStatus

                                    </span>


                                    <span class="min-w-16 text-right text-sm text-slate-500">

                                        @recordHours<span>h</span>

                                        @recordMinutes<span>m</span>

                                    </span>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="px-6 py-10 text-center">

                        <p class="text-sm font-medium text-slate-700">
                            No attendance records yet
                        </p>

                        <p class="mt-1 text-xs text-slate-500">
                            Your recorded attendance will appear here.
                        </p>

                    </div>
                }

            </section>



            <!-- ================================================== -->
            <!-- BIOMETRIC INFORMATION                              -->
            <!-- ================================================== -->

            <div class="mt-6 flex gap-3 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="mt-0.5 h-5 w-5 shrink-0 text-primary">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 11v5">
                    </path>

                    <path d="M12 8h.01">
                    </path>

                </svg>


                <div>

                    <p class="text-sm font-semibold text-slate-800">
                        Biometric Attendance
                    </p>

