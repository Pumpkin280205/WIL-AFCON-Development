@model List<WIL_Afcon.Models.Attendance>

@functions {

    // MongoDB returns UTC - convert to local time for display.
    private static string ShowTime(DateTime? value)
        => value.HasValue
            ? value.Value.ToLocalTime().ToString("HH:mm")
            : "-";

    private static string StatusBadge(
        WIL_Afcon.Models.Enums.AttendanceStatus status)
        => status switch
        {
            WIL_Afcon.Models.Enums.AttendanceStatus.Present
                => "bg-green-50 text-green-700 ring-green-200",

            WIL_Afcon.Models.Enums.AttendanceStatus.Late
                => "bg-amber-50 text-amber-700 ring-amber-200",

            WIL_Afcon.Models.Enums.AttendanceStatus.Absent
                => "bg-red-50 text-red-700 ring-red-200",

            WIL_Afcon.Models.Enums.AttendanceStatus.OnLeave
                => "bg-blue-50 text-blue-700 ring-blue-200",

            WIL_Afcon.Models.Enums.AttendanceStatus.HalfDay
                => "bg-purple-50 text-purple-700 ring-purple-200",

            _ => "bg-slate-100 text-slate-700 ring-slate-200"
        };
}

@{
    ViewData["Title"] = "My Attendance";

    var today =
        ViewBag.Today as WIL_Afcon.Models.Attendance;

    string nextScan;

    if (today?.ClockInTime == null)
    {
        nextScan = "Clock In";
    }
    else if (today.ClockOutTime != null)
    {
        nextScan =
            "Nothing - you have clocked out for today";
    }
    else if (today.IsOnBreak)
    {
        nextScan = "End Break";
    }
    else if (!today.Breaks.Any())
    {
        nextScan =
            "Start Break (or Clock Out if it is the end of the work day)";
    }
    else
    {
        nextScan =
            "Clock Out (end of the work day)";
    }

    var todayBreakMinutes =
        today?.Breaks.Sum(b => b.DurationMinutes) ?? 0;

    var todayHours =
        today?.WorkingMinutes / 60 ?? 0;

    var todayMinutes =
        today?.WorkingMinutes % 60 ?? 0;
}


<div class="min-h-screen bg-[#f5f7fc] lg:flex">

    <!-- ====================================================== -->
    <!-- EMPLOYEE SIDEBAR                                       -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:z-30 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary text-primary-content">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">

                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>

                </svg>

            </div>

            <div>

                <p class="text-base font-bold text-slate-900">
                    Afcon
                </p>

                <p class="text-sm text-slate-500">
                    Employee Portal
                </p>

            </div>

        </div>


        <!-- SIDEBAR CONTENT -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <!-- NAVIGATION -->
            <nav class="flex-1 overflow-y-auto px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-400">
                    Employee
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Employee"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>

                    </svg>

                    <span>Dashboard</span>

                </a>


                <!-- MY ATTENDANCE - ACTIVE -->
                <a asp-controller="Attendance"
                   asp-action="MyAttendance"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 2"></path>

                    </svg>

                    <span>My Attendance</span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary"></span>

                </a>


                <!-- MY ATTENDANCE REPORT -->
                <a asp-controller="AttendanceReport"
                   asp-action="MyReport"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M4 19V9"></path>
                        <path d="M10 19V5"></path>
                        <path d="M16 19v-7"></path>
                        <path d="M22 19V3"></path>

                    </svg>

                    <span>My Attendance Report</span>

                </a>


                <!-- MY REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="MyRequests"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                    </svg>

                    <span>My Requests</span>

                </a>


                <!-- MY DOCUMENTS -->
                <a asp-controller="Document"
                   asp-action="MyDocuments"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
                        <path d="M14 2v6h6"></path>
                        <path d="M8 13h8"></path>
                        <path d="M8 17h5"></path>

                    </svg>

                    <span>My Documents</span>

                </a>


                <!-- NEW REQUEST -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Create"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v8"></path>
                        <path d="M8 12h8"></path>

                    </svg>

                    <span>New Request</span>

                </a>


                <!-- MY PROFILE -->
                <a asp-controller="Employee"
                   asp-action="Profile"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5 shrink-0">

                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 21a8 8 0 0 1 16 0"></path>

                    </svg>

                    <span>My Profile</span>

                </a>

            </nav>


            <!-- SIGN OUT -->
            <div class="border-t border-slate-200 p-5">

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5 shrink-0">

                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21"
                                  x2="9"
                                  y1="12"
                                  y2="12">
                            </line>

                        </svg>

                        <span>Sign Out</span>

                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">

        <main id="main-content" tabindex="-1" class="mx-auto max-w-7xl p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- PAGE HEADER                                        -->
            <!-- ================================================== -->

            <div class="mb-7">

                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    My Attendance
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    View your attendance history and today's recorded activity.
                </p>

            </div>


            <!-- ================================================== -->
            <!-- TODAY'S ATTENDANCE                                 -->
            <!-- ================================================== -->

            <section class="mb-6 rounded-2xl bg-primary p-6 text-primary-content shadow-sm">

                <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">

                    <!-- TODAY INFO -->
                    <div>

                        <p class="text-sm font-medium opacity-75">
                            Today
                        </p>

                        <h2 class="mt-1 text-2xl font-bold">
                            @DateTime.Today.ToString("dddd, d MMMM yyyy")
                        </h2>

                        <p class="mt-3 max-w-2xl text-sm leading-6 opacity-80">
                            Scan your fingerprint or face on the
                            biometric device to record attendance.
                        </p>

                    </div>


                    <!-- NEXT SCAN -->
                    <div class="min-w-64 rounded-xl bg-white/10 px-5 py-4">

                        <p class="text-xs font-medium opacity-70">
                            Next Scan
                        </p>

                        <p class="mt-1 font-semibold">
                            @nextScan
                        </p>

                    </div>

                </div>

            </section>


            <!-- ================================================== -->
            <!-- TODAY SUMMARY                                      -->
            <!-- ================================================== -->

            <section class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">

                <!-- CLOCK IN -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <p class="text-sm font-medium text-slate-500">
                        Clock In
                    </p>

                    <p class="mt-3 text-2xl font-bold text-slate-900">
                        @ShowTime(today?.ClockInTime)
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Today
                    </p>

                </div>


                <!-- CLOCK OUT -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <p class="text-sm font-medium text-slate-500">
                        Clock Out
                    </p>

                    <p class="mt-3 text-2xl font-bold text-slate-900">
                        @ShowTime(today?.ClockOutTime)
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Today
                    </p>

                </div>


                <!-- BREAK TIME -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <p class="text-sm font-medium text-slate-500">
                        Break Time
                    </p>

                    <p class="mt-3 text-2xl font-bold text-slate-900">
                        @todayBreakMinutes min
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Today
                    </p>

                </div>


                <!-- WORKING TIME -->
                <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                    <p class="text-sm font-medium text-slate-500">
                        Working Time
                    </p>

                    <p class="mt-3 text-2xl font-bold text-slate-900">
                        @todayHours<span class="text-base">h</span>
                        @todayMinutes<span class="text-base">m</span>
                    </p>

                    <p class="mt-1 text-xs text-slate-500">
                        Today
                    </p>

                </div>

            </section>


            <!-- ================================================== -->
            <!-- ATTENDANCE HISTORY                                 -->
            <!-- ================================================== -->

            <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">

                <!-- TABLE HEADER -->
                <div class="flex flex-col gap-3 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">

                    <div>

                        <h2 class="text-lg font-bold text-slate-900">
                            Attendance History
                        </h2>

                        <p class="mt-1 text-xs text-slate-500">
                            Your recorded clock-in, break and clock-out history.
                        </p>

                    </div>


                    <div class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
                        @Model.Count record@(Model.Count == 1 ? "" : "s")
                    </div>

                </div>


                @if (!Model.Any())
                {
                    <!-- EMPTY STATE -->
                    <div class="px-6 py-16 text-center">

                        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-6 w-6">

                                <circle cx="12"
                                        cy="12"
                                        r="9">
                                </circle>

                                <path d="M12 7v5l3 2"></path>

                            </svg>

                        </div>


                        <h3 class="mt-4 font-semibold text-slate-900">
                            No attendance records yet
                        </h3>

                        <p class="mt-1 text-sm text-slate-500">
                            Scan on the biometric device to clock in.
                        </p>

                    </div>
                }
                else
                {
                    <!-- TABLE -->
                    <div class="w-full">

                        <table class="w-full table-fixed text-left">

                            <thead class="bg-slate-50">

                                <tr class="border-b border-slate-200 text-xs font-semibold uppercase tracking-wide text-slate-500">

                                    <th class="w-[16%] px-4 py-4">
                                        Date
                                    </th>

                                    <th class="w-[10%] px-3 py-4">
                                        Clock In
                                    </th>

                                    <th class="w-[12%] px-3 py-4">
                                        Break Start
                                    </th>

                                    <th class="w-[12%] px-3 py-4">
                                        Break End
                                    </th>

                                    <th class="w-[10%] px-3 py-4">
                                        Clock Out
                                    </th>

                                    <th class="w-[11%] px-3 py-4">
                                        Break
                                    </th>

                                    <th class="w-[15%] px-3 py-4">
                                        Working Time
                                    </th>

                                    <th class="w-[14%] px-3 py-4">
                                        Status
                                    </th>

                                </tr>

                            </thead>


                            <tbody class="divide-y divide-slate-100">

                                @foreach (var a in Model)
                                {
                                    var date =
                                        a.AttendanceDate
                                            .ToLocalTime()
                                            .Date;

                                    var isToday =
                                        date == DateTime.Today;

                                    var firstBreak =
                                        a.Breaks
                                            .OrderBy(b => b.StartTime)
                                            .FirstOrDefault();

                                    var extraBreaks =
                                        Math.Max(
                                            0,
                                            a.Breaks.Count - 1);

                                    var breakMinutes =
                                        a.Breaks.Sum(
                                            b => b.DurationMinutes);

                                    var workingHours =
                                        a.WorkingMinutes / 60;

                                    var workingMinutes =
                                        a.WorkingMinutes % 60;


                                    <tr class="@(isToday
                                        ? "bg-primary/5"
                                        : "bg-white")">

                                        <!-- DATE -->
                                        <td class="px-4 py-4">

                                            <div class="flex items-center gap-2">

                                                <span class="text-sm font-semibold text-slate-900">
                                                    @date.ToString("dd MMM yyyy")
                                                </span>


                                                @if (isToday)
                                                {
                                                    <span class="rounded-full bg-primary/10 px-2 py-0.5 text-[10px] font-semibold text-primary">
                                                        Today
                                                    </span>
                                                }

                                            </div>

                                        </td>


                                        <!-- CLOCK IN -->
                                        <td class="px-3 py-4 text-sm text-slate-600">
                                            @ShowTime(a.ClockInTime)
                                        </td>


                                        <!-- BREAK START -->
                                        <td class="px-3 py-4 text-sm text-slate-600">

                                            <div>

                                                @ShowTime(firstBreak?.StartTime)

                                                @if (extraBreaks > 0)
                                                {
                                                    <div class="mt-1 text-[10px] text-slate-400">
                                                        +@extraBreaks more
                                                    </div>
                                                }

                                            </div>

                                        </td>


                                        <!-- BREAK END -->
                                        <td class="px-3 py-4 text-sm text-slate-600">

                                            @if (firstBreak != null &&
                                                 firstBreak.EndTime == null)
                                            {
                                                <span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-200">
                                                    On break
                                                </span>
                                            }
                                            else
                                            {
                                                @ShowTime(firstBreak?.EndTime)
                                            }

                                        </td>


                                        <!-- CLOCK OUT -->
                                        <td class="px-3 py-4 text-sm text-slate-600">
                                            @ShowTime(a.ClockOutTime)
                                        </td>


                                        <!-- BREAK MINUTES -->
                                        <td class="px-3 py-4 text-sm text-slate-600">

                                            @(a.Breaks.Any()
                                                ? $"{breakMinutes} min"
                                                : "-")

                                        </td>


                                        <!-- WORKING TIME -->
                                        <td class="px-3 py-4">

                                            @if (a.ClockInTime != null &&
                                                 a.ClockOutTime == null)
                                            {
                                                <span class="text-xs font-medium text-slate-500">

                                                    @(isToday
                                                        ? "In progress"
                                                        : "Not clocked out")

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-sm font-medium text-slate-700">
                                                    @workingHours<span>h</span>
                                                    @workingMinutes<span>m</span>
                                                </span>
                                            }

                                        </td>


                                        <!-- STATUS -->
                                        <td class="px-3 py-4">

                                            <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @StatusBadge(a.AttendanceStatus)">
                                                @a.AttendanceStatus
                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </section>


            <!-- ================================================== -->
            <!-- INFORMATION                                        -->
            <!-- ================================================== -->

            <div class="mt-6 flex gap-3 rounded-xl border border-primary/20 bg-primary/5 px-5 py-4">

                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="mt-0.5 h-5 w-5 shrink-0 text-primary">

                    <circle cx="12"
                            cy="12"
                            r="9">
                    </circle>

                    <path d="M12 11v5"></path>
                    <path d="M12 8h.01"></path>

                </svg>


                <div>

                    <p class="text-sm font-semibold text-slate-800">
                        Attendance Recording
                    </p>

                    <p class="mt-1 text-xs leading-5 text-slate-600">
                        Clock-in, break and clock-out activity is
                        recorded through the biometric attendance
                        device and displayed here automatically.
                    </p>

                </div>

            </div>

        </main>

    </div>

</div>


@section Scripts
{
    <script src="~/js/attendance-realtime.js"></script>
}