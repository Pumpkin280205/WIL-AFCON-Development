@model List<WIL_Afcon.Models.Attendance>

@functions {
    // MongoDB returns UTC - convert to local time for display.
    private static string ShowTime(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("HH:mm") : "-";

    private static string StatusBadge(WIL_Afcon.Models.Enums.AttendanceStatus status)
        => status switch
        {
            WIL_Afcon.Models.Enums.AttendanceStatus.Present => "bg-success",
            WIL_Afcon.Models.Enums.AttendanceStatus.Late => "bg-warning text-dark",
            WIL_Afcon.Models.Enums.AttendanceStatus.Absent => "bg-secondary",
            _ => "bg-info text-dark"
        };
}

@{
    ViewData["Title"] = "My Attendance";

    var today = ViewBag.Today as WIL_Afcon.Models.Attendance;

    string nextScan;
    if (today?.ClockInTime == null)
    {
        nextScan = "Clock In";
    }
    else if (today.ClockOutTime != null)
    {
        nextScan = "Nothing - you have clocked out for today";
    }
    else if (today.IsOnBreak)
    {
        nextScan = "End Break";
    }
    else if (!today.Breaks.Any())
    {
        nextScan = "Start Break (or Clock Out if it is the end of the work day)";
    }
    else
    {
        nextScan = "Clock Out (end of the work day)";
    }
}

<div class="container mt-4">
    <h1>My Attendance</h1>

    <div class="alert alert-info">
        <strong>Today &ndash; @DateTime.Today.ToString("yyyy/MM/dd")</strong><br />
        Scan your fingerprint / face on the device to record attendance.
        Your next scan will record: <strong>@nextScan</strong>
    </div>

    @if (!Model.Any())
    {
        <p>No attendance records yet. Scan on the device to clock in.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Clock In</th>
                        <th>Break Start</th>
                        <th>Break End</th>
                        <th>Clock Out</th>
                        <th>Break (min)</th>
                        <th>Working Minutes</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        var date = a.AttendanceDate.ToLocalTime().Date;
                        var isToday = date == DateTime.Today;
                        var firstBreak = a.Breaks.OrderBy(b => b.StartTime).FirstOrDefault();
                        var extraBreaks = Math.Max(0, a.Breaks.Count - 1);
                        var breakMinutes = a.Breaks.Sum(b => b.DurationMinutes);

                        <tr class="@(isToday ? "table-primary fw-semibold" : "")">
                            <td>
                                @date.ToString("yyyy/MM/dd")
                                @if (isToday)
                                {
                                    <span class="badge bg-primary ms-1">Today</span>
                                }
                            </td>
                            <td>@ShowTime(a.ClockInTime)</td>
                            <td>
                                @ShowTime(firstBreak?.StartTime)
                                @if (extraBreaks > 0)
                                {
                                    <small class="text-muted">(+@extraBreaks more)</small>
                                }
                            </td>
                            <td>
                                @if (firstBreak != null && firstBreak.EndTime == null)
                                {
                                    <span class="badge bg-warning text-dark">On break</span>
                                }
                                else
                                {
                                    @ShowTime(firstBreak?.EndTime)
                                }
                            </td>
                            <td>@ShowTime(a.ClockOutTime)</td>
                            <td>@(a.Breaks.Any() ? breakMinutes.ToString() : "-")</td>
                            <td>
                                @if (a.ClockInTime != null && a.ClockOutTime == null)
                                {
                                    <span class="text-muted">@(isToday ? "In progress" : "Not clocked out")</span>
                                }
                                else
                                {
                                    @a.WorkingMinutes
                                }
                            </td>
                            <td><span class="badge @StatusBadge(a.AttendanceStatus)">@a.AttendanceStatus</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts
{
    <script src="~/js/attendance-realtime.js"></script>
}