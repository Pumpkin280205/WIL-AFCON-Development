@model List<WIL_Afcon.Models.ViewModels.AttendanceListItemViewModel>

@{
    ViewData["Title"] = "Attendance";
}

<div class="min-h-screen bg-[#f5f7fc] lg:flex">

    <!-- ====================================================== -->
    <!-- SIDEBAR                                                -->
    <!-- ====================================================== -->

    <aside class="w-full border-b border-slate-200 bg-white lg:fixed lg:inset-y-0 lg:left-0 lg:w-72 lg:border-b-0 lg:border-r">

        <!-- BRAND -->
        <div class="flex h-24 items-center gap-3 border-b border-slate-200 px-7">

            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary text-primary-content">
                <svg xmlns="http://www.w3.org/2000/svg"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     class="h-5 w-5">
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 7v5l3 2"></path>
                </svg>
            </div>

            <div>
                <p class="font-bold text-slate-900">
                    Afcon
                </p>
                <p class="text-sm text-slate-500">
                    Admin Panel
                </p>
            </div>

        </div>


        <!-- NAVIGATION -->
        <div class="flex h-[calc(100vh-6rem)] flex-col">

            <nav class="flex-1 px-4 py-7">

                <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-widest text-slate-500">
                    Administration
                </p>


                <!-- DASHBOARD -->
                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">
                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                    </svg>

                    Dashboard
                </a>


                <!-- EMPLOYEES -->
                <a asp-controller="Employee"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>

                    Employees
                </a>


                <!-- DEPARTMENTS -->
                <a asp-controller="Department"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">
                        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
                        <path d="M9 22v-4h6v4"></path>
                        <path d="M8 6h.01"></path>
                        <path d="M12 6h.01"></path>
                        <path d="M16 6h.01"></path>
                    </svg>

                    Departments
                </a>


                <!-- ATTENDANCE - ACTIVE -->
                <a asp-controller="Attendance"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl bg-primary/10 px-4 py-3 text-sm font-semibold text-primary no-underline">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">
                        <path d="M8 2v4"></path>
                        <path d="M16 2v4"></path>
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <path d="M3 10h18"></path>
                    </svg>

                    <span>Attendance</span>

                    <span class="ml-auto h-2 w-2 rounded-full bg-primary"></span>
                </a>


                <!-- REQUESTS -->
                <a asp-controller="AttendanceRequest"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">
                        <path d="M9 11l3 3L22 4"></path>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                    </svg>

                    Requests
                </a>


                <!-- REPORTS -->
                <a asp-controller="AttendanceReport"
                   asp-action="Index"
                   class="mb-1 flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-slate-600 no-underline transition hover:bg-slate-100 hover:text-primary">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         class="h-5 w-5">
                        <path d="M3 3v18h18"></path>
                        <path d="m7 16 4-4 4 4 5-6"></path>
                    </svg>

                    Reports
                </a>

            </nav>


            <!-- SIDEBAR BOTTOM -->
            <div class="border-t border-slate-200 p-5">

                <div class="mb-4 flex items-center gap-3">

                    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary font-semibold text-primary-content">
                        A
                    </div>

                    <div>
                        <p class="text-sm font-semibold text-slate-900">
                            Administrator
                        </p>
                        <p class="text-xs text-slate-500">
                            Admin
                        </p>
                    </div>

                </div>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="flex w-full items-center gap-3 rounded-lg px-2 py-2 text-sm font-medium text-slate-600 transition hover:bg-red-50 hover:text-red-600">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" x2="9" y1="12" y2="12"></line>
                        </svg>

                        Sign Out
                    </button>

                </form>

            </div>

        </div>

    </aside>


    <!-- ====================================================== -->
    <!-- MAIN CONTENT                                           -->
    <!-- ====================================================== -->

    <div class="min-w-0 flex-1 lg:ml-72">

        <main class="p-6 lg:p-9">


            <!-- ================================================== -->
            <!-- PAGE HEADER                                       -->
            <!-- ================================================== -->

            <div class="mb-7">

                <h1 class="text-3xl font-bold tracking-tight text-slate-900">
                    Attendance
                </h1>

                <p class="mt-1 text-sm text-slate-500">
                    View and monitor employee attendance records.
                </p>

            </div>


            <!-- ================================================== -->
            <!-- FILTER CARD                                       -->
            <!-- ================================================== -->

            <div class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">

                <div class="mb-4 flex items-center gap-3">

                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-4 w-4">
                            <path d="M4 21v-7"></path>
                            <path d="M4 10V3"></path>
                            <path d="M12 21v-9"></path>
                            <path d="M12 8V3"></path>
                            <path d="M20 21v-5"></path>
                            <path d="M20 12V3"></path>
                            <path d="M1 14h6"></path>
                            <path d="M9 8h6"></path>
                            <path d="M17 16h6"></path>
                        </svg>

                    </div>

                    <div>
                        <h2 class="text-sm font-semibold text-slate-900">
                            Filter Attendance
                        </h2>

                        <p class="text-xs text-slate-500">
                            Select a date range to view attendance records.
                        </p>
                    </div>

                </div>


                <form asp-action="Index"
                      method="get"
                      class="flex flex-col gap-4 sm:flex-row sm:items-end">

                    <!-- FROM -->
                    <div class="w-full sm:max-w-56">

                        <label for="from"
                               class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                            From
                        </label>

                        <input type="date"
                               id="from"
                               name="from"
                               value="@ViewBag.From"
                               class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10" />

                    </div>


                    <!-- TO -->
                    <div class="w-full sm:max-w-56">

                        <label for="to"
                               class="mb-2 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                            To
                        </label>

                        <input type="date"
                               id="to"
                               name="to"
                               value="@ViewBag.To"
                               class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/10" />

                    </div>


                    <!-- FILTER BUTTONS -->
                    <div class="flex items-center gap-2">

                        <button type="submit"
                                class="inline-flex h-[42px] items-center justify-center gap-2 rounded-lg bg-primary px-5 text-sm font-semibold text-primary-content shadow-sm transition hover:opacity-90">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-4 w-4">
                                <path d="M22 3H2l8 9.46V19l4 2v-8.54Z"></path>
                            </svg>

                            Filter

                        </button>


                        <a asp-controller="Attendance"
                           asp-action="Index"
                           class="inline-flex h-[42px] items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-5 text-sm font-semibold text-slate-600 no-underline transition hover:bg-slate-100 hover:text-slate-800">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 class="h-4 w-4">
                                <path d="M18 6 6 18"></path>
                                <path d="m6 6 12 12"></path>
                            </svg>

                            Clear

                        </a>

                    </div>

                </form>

            </div>


            <!-- ================================================== -->
            <!-- ATTENDANCE TABLE                                  -->
            <!-- ================================================== -->

            <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">


                <!-- TABLE CARD HEADER -->
                <div class="flex items-center justify-between border-b border-slate-200 px-6 py-5">

                    <div>

                        <h2 class="text-lg font-semibold text-slate-900">
                            Attendance Records
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            @Model.Count record@(Model.Count == 1 ? "" : "s") found
                        </p>

                    </div>


                    <div class="hidden h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary sm:flex">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             class="h-5 w-5">
                            <path d="M8 2v4"></path>
                            <path d="M16 2v4"></path>
                            <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                            <path d="M3 10h18"></path>
                        </svg>

                    </div>

                </div>


                @if (!Model.Any())
                {
                    <!-- EMPTY STATE -->
                    <div class="flex min-h-72 items-center justify-center px-6 py-12">

                        <div class="text-center">

                            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-primary/10 text-primary">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     class="h-6 w-6">
                                    <path d="M8 2v4"></path>
                                    <path d="M16 2v4"></path>
                                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                    <path d="M3 10h18"></path>
                                    <path d="M9 16h6"></path>
                                </svg>

                            </div>

                            <h3 class="mt-4 font-semibold text-slate-900">
                                No attendance records found
                            </h3>

                            <p class="mt-1 text-sm text-slate-500">
                                Try selecting a different date range.
                            </p>

                        </div>

                    </div>
                }
                else
                {
                    <!-- ================================================== -->
                    <!-- TABLE                                              -->
                    <!-- ================================================== -->

                    <div>

                        <table class="w-full table-fixed text-left">

                            <thead class="bg-slate-50">

                                <tr class="border-b border-slate-200">

                                    <!-- DATE -->
                                    <th class="w-[17%] px-4 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Date
                                    </th>

                                    <!-- EMPLOYEE -->
                                    <th class="w-[15%] px-3 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Employee
                                    </th>

                                    <!-- EMPLOYEE NUMBER -->
                                    <th class="w-[9%] px-3 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Emp #
                                    </th>

                                    <!-- DEPARTMENT -->
                                    <th class="w-[13%] px-3 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Department
                                    </th>

                                    <!-- CLOCK IN -->
                                    <th class="w-[10%] px-3 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Clock In
                                    </th>

                                    <!-- CLOCK OUT -->
                                    <th class="w-[10%] px-3 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Clock Out
                                    </th>

                                    <!-- STATUS -->
                                    <th class="w-[11%] px-3 py-3.5 text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Status
                                    </th>

                                    <!-- WORKING MINUTES -->
                                    <th class="w-[15%] px-4 py-3.5 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
                                        Working Minutes
                                    </th>

                                </tr>

                            </thead>


                            <tbody class="divide-y divide-slate-100">

                                @foreach (var a in Model)
                                {
                                    <tr class="transition hover:bg-slate-50">


                                        <!-- DATE -->
                                        <td class="whitespace-nowrap px-4 py-4">

                                            <div class="flex items-center gap-2">

                                                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500">

                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                         viewBox="0 0 24 24"
                                                         fill="none"
                                                         stroke="currentColor"
                                                         stroke-width="2"
                                                         class="h-4 w-4">
                                                        <path d="M8 2v4"></path>
                                                        <path d="M16 2v4"></path>
                                                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                                                        <path d="M3 10h18"></path>
                                                    </svg>

                                                </div>

                                                <span class="text-sm font-medium text-slate-700">
                                                    @a.AttendanceDate.ToLocalTime().ToString("dd MMM yyyy")
                                                </span>

                                            </div>

                                        </td>


                                        <!-- EMPLOYEE -->
                                        <td class="min-w-0 px-3 py-4">

                                            <p class="truncate text-sm font-semibold text-slate-900"
                                               title="@a.EmployeeName">
                                                @a.EmployeeName
                                            </p>

                                        </td>


                                        <!-- EMPLOYEE NUMBER -->
                                        <td class="truncate whitespace-nowrap px-3 py-4 text-sm text-slate-600"
                                            title="@a.EmployeeNumber">
                                            @a.EmployeeNumber
                                        </td>


                                        <!-- DEPARTMENT -->
                                        <td class="min-w-0 px-3 py-4">

                                            <span class="inline-block max-w-full truncate rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600"
                                                  title="@a.DepartmentName">
                                                @a.DepartmentName
                                            </span>

                                        </td>


                                        <!-- CLOCK IN -->
                                        <td class="whitespace-nowrap px-3 py-4">

                                            <span class="text-sm font-medium text-slate-700">
                                                @(a.ClockInTime?.ToLocalTime().ToString("HH:mm") ?? "-")
                                            </span>

                                        </td>


                                        <!-- CLOCK OUT -->
                                        <td class="whitespace-nowrap px-3 py-4">

                                            <span class="text-sm font-medium text-slate-700">
                                                @(a.ClockOutTime?.ToLocalTime().ToString("HH:mm") ?? "-")
                                            </span>

                                        </td>


                                        <!-- STATUS -->
                                        <td class="whitespace-nowrap px-3 py-4">

                                            @if (a.AttendanceStatus.ToString() == "Present")
                                            {
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-green-50 px-2.5 py-1 text-xs font-semibold text-green-700 ring-1 ring-green-200">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
                                                    Present
                                                </span>
                                            }
                                            else if (a.AttendanceStatus.ToString() == "Late")
                                            {
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-amber-200">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                                                    Late
                                                </span>
                                            }
                                            else if (a.AttendanceStatus.ToString() == "OnLeave")
                                            {
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 ring-1 ring-blue-200">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
                                                    On Leave
                                                </span>
                                            }
                                            else if (a.AttendanceStatus.ToString() == "HalfDay")
                                            {
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-purple-50 px-2.5 py-1 text-xs font-semibold text-purple-700 ring-1 ring-purple-200">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-purple-500"></span>
                                                    Half Day
                                                </span>
                                            }
                                            else if (a.AttendanceStatus.ToString() == "Absent")
                                            {
                                                <span class="inline-flex items-center gap-1.5 rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-200">
                                                    <span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
                                                    Absent
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                                                    @a.AttendanceStatus
                                                </span>
                                            }

                                        </td>


                                        <!-- WORKING MINUTES -->
                                        <td class="whitespace-nowrap px-4 py-4 text-right">

                                            <span class="text-sm font-semibold text-slate-700">
                                                @a.WorkingMinutes
                                            </span>

                                            <span class="ml-1 text-xs text-slate-400">
                                                min
                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </main>

    </div>

</div>


@section Scripts
{
    <script src="~/js/attendance-realtime.js"></script>
}