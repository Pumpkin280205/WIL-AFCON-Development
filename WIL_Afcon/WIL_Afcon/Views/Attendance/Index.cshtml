@model List<WIL_Afcon.Models.ViewModels.AttendanceListItemViewModel>

@{
    ViewData["Title"] = "Attendance";
}

<div class="container mt-4">
    <h1>Attendance</h1>

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <label class="form-label">From</label>
            <input type="date" name="from" value="@ViewBag.From"
                   class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label">To</label>
            <input type="date" name="to" value="@ViewBag.To"
                   class="form-control" />
        </div>
        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <p>No attendance records found.</p>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Employee</th>
                    <th>Emp #</th>
                    <th>Department</th>
                    <th>Clock In</th>
                    <th>Clock Out</th>
                    <th>Status</th>
                    <th>Working Minutes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.AttendanceDate.ToLocalTime().ToShortDateString()</td>
                        <td>@a.EmployeeName</td>
                        <td>@a.EmployeeNumber</td>
                        <td>@a.DepartmentName</td>
                        <td>@(a.ClockInTime?.ToLocalTime().ToString("HH:mm") ?? "-")</td>
                        <td>@(a.ClockOutTime?.ToLocalTime().ToString("HH:mm") ?? "-")</td>
                        <td>@a.AttendanceStatus</td>
                        <td>@a.WorkingMinutes</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
@section Scripts
{
    <script src="~/js/attendance-realtime.js"></script>
}